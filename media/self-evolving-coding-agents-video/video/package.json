{
  "name": "self-evolving-coding-agents-video",
  "private": true,
  "description": "《会写代码的 AI，开始给自己写代码》科普视频 Remotion 工程",
  "scripts": {
    "dev": "remotion studio",
    "typecheck": "tsc --noEmit",
