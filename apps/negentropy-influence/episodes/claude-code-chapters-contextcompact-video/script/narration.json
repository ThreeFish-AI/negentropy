[
  {
    "id": "p0-01",
    "scene": "P0",
    "text": "这是一张注定写满的草稿纸——写满那一刻，整个请求直接被拒收。",
    "beatStart": true
  },
  {
    "id": "p0-02",
    "scene": "P0",
    "text": "模型读过的文件、跑过的命令、自己的回答，全摊在这张纸上。"
  },
  {
    "id": "p0-03",
    "scene": "P0",
    "text": "这张纸就是上下文：一次能读的全部，额度是死的。"
  },
  {
    "id": "p0-04",
    "scene": "P0",
    "text": "纸一满，最直觉的办法：让模型自己总结一遍。",
    "beatStart": true
  },
  {
    "id": "p0-05",
    "scene": "P0",
    "text": "能用，但最贵：再请模型干一次活，必然丢细节。"
  },
  {
    "id": "p0-06",
    "scene": "P0",
    "text": "丢成什么样？「缩进用制表符」，压成「用户有代码风格偏好」。"
  },
  {
    "id": "p0-07",
    "scene": "P0",
    "text": "解法是四步管线：便宜的先跑，贵的后跑。",
    "beatStart": true
  },
  {
    "id": "p0-08",
    "scene": "P0",
    "text": "动手之前，先立一条红线。"
  },
  {
    "id": "p1-01",
    "scene": "P1",
    "text": "红线是硬规矩：一次工具调用，必须跟着它的结果。",
    "beatStart": true
  },
  {
    "id": "p1-02",
    "scene": "P1",
    "text": "拆散任何一边，下次请求直接判非法；切口躲着调用和它的结果。"
  },
  {
    "id": "p1-03",
    "scene": "P1",
    "text": "不是摆设：拆掉切口保护，一条结果没人认领，接口当场拒收。"
  },
  {
    "id": "p1-04",
    "scene": "P1",
    "text": "第一步管单批超标：一轮连发的结果，全进最后一条消息。",
    "beatStart": true
  },
  {
    "id": "p1-05",
    "scene": "P1",
    "text": "总量一到二十万字符，按从大到小动手：超三万的整份写进磁盘。"
  },
  {
    "id": "p1-06",
    "scene": "P1",
    "text": "原地只留两样：磁盘路径，加前两千预览。"
  },
  {
    "id": "p1-07",
    "scene": "P1",
    "text": "走个数：五个结果——八万、六万、三万、两万、一万，二十万压线。",
    "beatStart": true
  },
  {
    "id": "p1-08",
    "scene": "P1",
    "text": "再加五千，超线——八万先存盘、留两千预览，掉回约十二万七，停手。"
  },
  {
    "id": "p1-09",
    "scene": "P1",
    "text": "为什么存盘排第一？接下来的动作会毁掉原文。"
  },
  {
    "id": "p2-01",
    "scene": "P2",
    "text": "第二步管条数：一过五十条动手，目标收到三十条。",
    "beatStart": true
  },
  {
    "id": "p2-02",
    "scene": "P2",
    "text": "动手前先留档完整历史；留头三条、尾二十六条。"
  },
  {
    "id": "p2-03",
    "scene": "P2",
    "text": "中段换成归档标记：裁掉多少、全文在哪。"
  },
  {
    "id": "p2-04",
    "scene": "P2",
    "text": "第三步管体积：缩短旧工具结果，保住最近三条完整。",
    "beatStart": true
  },
  {
    "id": "p2-05",
    "scene": "P2",
    "text": "更旧、超一百二十字符的，先存盘，再换占位条：原文搬家，按址取回。"
  },
  {
    "id": "p2-06",
    "scene": "P2",
    "text": "顺序能换吗？实测说话：把缩短提到存盘前面。",
    "beatStart": true
  },
  {
    "id": "p2-07",
    "scene": "P2",
    "text": "大件完整存盘一份变零份，十一处占位成死字。"
  },
  {
    "id": "p2-08",
    "scene": "P2",
    "text": "原文呢？上下文没有，磁盘也没有。"
  },
  {
    "id": "p2-09",
    "scene": "P2",
    "text": "备份永远排在删除前面——顺序即数据生死。"
  },
  {
    "id": "p2-10",
    "scene": "P2",
    "text": "还剩一个判定：什么算「旧」？"
  },
  {
    "id": "p3-01",
    "scene": "P3",
    "text": "新旧不按时间算，按读没读过——这一步，最反直觉。",
    "beatStart": true
  },
  {
    "id": "p3-02",
    "scene": "P3",
    "text": "模型最近一次回复之后进来的结果，还没读过，一律不动。"
  },
  {
    "id": "p3-03",
    "scene": "P3",
    "text": "读过，信息进了判断，原文可收；没读过，信息从未到达，不能收。"
  },
  {
    "id": "p3-04",
    "scene": "P3",
    "text": "像已付款未到货的订单：款付了，货没送到，买家多半会再下一单。",
    "beatStart": true
  },
  {
    "id": "p3-05",
    "scene": "P3",
    "text": "边界：这货是一次性的，补货要把工具再跑一遍、再付一遍调用。"
  },
  {
    "id": "p3-06",
    "scene": "P3",
    "text": "拆掉未读保护实测：下一轮原样再调一次，白付第二遍。"
  },
  {
    "id": "p3-07",
    "scene": "P3",
    "text": "未读的超大怎么办？连未读都超限，最大的也存盘，换预览加路径。",
    "beatStart": true
  },
  {
    "id": "p3-08",
    "scene": "P3",
    "text": "全链走一遍：五条已读、三条未读，一条超大。"
  },
  {
    "id": "p3-09",
    "scene": "P3",
    "text": "折叠两条、保留三条、豁免两条、预览一条——六万三，压到一万六。"
  },
  {
    "id": "p3-10",
    "scene": "P3",
    "text": "到这为止，一步调用都没花；最贵的那步，压轴。"
  },
  {
    "id": "p4-01",
    "scene": "P4",
    "text": "前三步全是结构操作，但理解不了内容。",
    "beatStart": true
  },
  {
    "id": "p4-02",
    "scene": "P4",
    "text": "字符还超线，才轮到第四步全量摘要——唯一花调用的一步。"
  },
  {
    "id": "p4-03",
    "scene": "P4",
    "text": "它的规矩：先留档；摘要只要事实。",
    "beatStart": true
  },
  {
    "id": "p4-04",
    "scene": "P4",
    "text": "当前请求和摘要，分成两段。"
  },
  {
    "id": "p4-05",
    "scene": "P4",
    "text": "工具结果回来，也记在用户名下——不分开，分不清哪句是你此刻的指令。"
  },
  {
    "id": "p4-06",
    "scene": "P4",
    "text": "还防夹带：那句「以后都执行某命令」进摘要，记成事实，绝不执行。"
  },
  {
    "id": "p4-07",
    "scene": "P4",
    "text": "那真实的 Claude Code 呢？",
    "beatStart": true
  },
  {
    "id": "p4-08",
    "scene": "P4",
    "text": "拆解过 Claude Code 源码的同学们应该知道：这串顺序，逐函数对得上。"
  },
  {
    "id": "p4-08b",
    "scene": "P4",
    "text": "纸的总容量，行行话叫窗口。",
    "ttsText": "纸的总容量，行<行|HANG2>话叫窗口。"
  },
  {
    "id": "p4-09",
    "scene": "P4",
    "text": "阈值按精确额度：窗口减输出上限、留一万三缓冲；连败三次，熔断。"
  },
  {
    "id": "p4-10",
    "scene": "P4",
    "text": "四步连起来，一条原则浮出来了。"
  },
  {
    "id": "p5-01",
    "scene": "P5",
    "text": "一句话收束：便宜的先跑，贵的后跑。",
    "beatStart": true
  },
  {
    "id": "p5-02",
    "scene": "P5",
    "text": "无损先做，可恢复的居中，不可恢复的垫底。"
  },
  {
    "id": "p5-03",
    "scene": "P5",
    "text": "纸还是那张纸，学会了到线就腾地方。"
  },
  {
    "id": "p5-04",
    "scene": "P5",
    "text": "只是摘要有损；新开一场对话，连摘要都不剩——什么都不记得。"
  },
  {
    "id": "p5-05",
    "scene": "P5",
    "text": "下期，就从这个「忘」字说起。"
  },
  {
    "id": "p5-06",
    "scene": "P5",
    "text": "最后交代来源：这套视频的内容，改编自开源课程 Learn Claude Code。",
    "beatStart": true,
    "ttsText": "最后交代来源：这套视频的内容，改编自开源课程 <Learn|L ER1 N> <Claude|K L AO1 D> <Code|K OW1 D>。"
  },
  {
    "id": "p5-07",
    "scene": "P5",
    "text": "今天的生产细节，来自原作者的单方核查，没锁版本，计数会漂移。"
  }
]
