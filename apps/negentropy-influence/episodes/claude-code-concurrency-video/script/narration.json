[
  {
    "id": "p0-01",
    "scene": "P0",
    "text": "这是一台好机器——可只要拆掉一个零件，它就换一种死法。",
    "beatStart": true
  },
  {
    "id": "p0-02",
    "scene": "P0",
    "text": "好机器说的是一整套让 AI 自己干活的装置，行话叫 Harness。"
  },
  {
    "id": "p0-03",
    "scene": "P0",
    "text": "场景请回来：一间通宵不打烊的工坊。",
    "beatStart": true
  },
  {
    "id": "p0-04",
    "scene": "P0",
    "text": "模型是台前的师傅，手快，但时间和记性都不归他管。"
  },
  {
    "id": "p0-05",
    "scene": "P0",
    "text": "主循环是一条不停转的传送带：师傅开口要工具，装置执行，结果递回。"
  },
  {
    "id": "p0-06",
    "scene": "P0",
    "text": "麻烦出在两种等待上。第一种：慢活堵路。",
    "beatStart": true
  },
  {
    "id": "p0-07",
    "scene": "P0",
    "text": "装框架要十分钟，构建要三分钟——都是真例子。"
  },
  {
    "id": "p0-08",
    "scene": "P0",
    "text": "更疼的是，师傅按处理字数计费——干等十分钟，钱照烧。"
  },
  {
    "id": "p0-09",
    "scene": "P0",
    "text": "第二种：到点的活没人推。",
    "beatStart": true
  },
  {
    "id": "p0-10",
    "scene": "P0",
    "text": "每天早上九点跑测试、每半小时看构建，全得有人开口才动。"
  },
  {
    "id": "p0-11",
    "scene": "P0",
    "text": "两种白等一个病根：等待塞进了传送带，触发权攥在人和师傅手里。"
  },
  {
    "id": "p0-12",
    "scene": "P0",
    "text": "把它们赶出去，还不违反规矩——这是今天要做的事。"
  },
  {
    "id": "p1-01",
    "scene": "P1",
    "text": "师傅和装置之间，是一问一答的对话协议。",
    "beatStart": true
  },
  {
    "id": "p1-02",
    "scene": "P1",
    "text": "师傅说「调这个工具」，装置执行，结果交回，他才说下一步。"
  },
  {
    "id": "p1-03",
    "scene": "P1",
    "text": "慢命令一跑，问答就卡在半路，整条传送带停摆。"
  },
  {
    "id": "p1-04",
    "scene": "P1",
    "text": "病根说穿了很简单：这套循环没有时间感，等的活全变成了堵的活。"
  },
  {
    "id": "p1-05",
    "scene": "P1",
    "text": "到点的活也一样：没人喊，循环根本不知道九点该干活。",
    "beatStart": true
  },
  {
    "id": "p1-06",
    "scene": "P1",
    "text": "于是设计规格只有两条，条条对症。"
  },
  {
    "id": "p1-07",
    "scene": "P1",
    "text": "第一条：慢活异步做，先回一句话，结果做完另行通知。"
  },
  {
    "id": "p1-08",
    "scene": "P1",
    "text": "第二条：定时和执行拆开，到点先记账，有空再干活。"
  },
  {
    "id": "p1-09",
    "scene": "P1",
    "text": "两条规格，落在工坊里就是两台新装置。",
    "beatStart": true
  },
  {
    "id": "p1-10",
    "scene": "P1",
    "text": "一台是自动清洗槽：慢活丢进去，按下走开，洗完喊你。"
  },
  {
    "id": "p1-11",
    "scene": "P1",
    "text": "一台是墙上的定时钟：到点自响，不等人推。"
  },
  {
    "id": "p1-12",
    "scene": "P1",
    "text": "它们工作得很好——好到你会以为没什么可讲。"
  },
  {
    "id": "p1-13",
    "scene": "P1",
    "text": "哪个零件都别小看，实验室里逐个拆给你看。"
  },
  {
    "id": "p1-14",
    "scene": "P1",
    "text": "先看第一台，清洗槽。",
    "beatStart": true
  },
  {
    "id": "p1-15",
    "scene": "P1",
    "text": "它先要解决的不是怎么放到后台去跑，是一条铁规矩。"
  },
  {
    "id": "p1-16",
    "scene": "P1",
    "text": "什么规矩？下一幕，从一张订单说起。"
  },
  {
    "id": "p2-01",
    "scene": "P2",
    "text": "对话协议有条硬规矩：一次调用，只配一个结果。",
    "beatStart": true
  },
  {
    "id": "p2-02",
    "scene": "P2",
    "text": "想先回一个、回头再补一个？不行，应答名额只有一个。"
  },
  {
    "id": "p2-03",
    "scene": "P2",
    "text": "这就像网购：下单那刻必须有回音，哪怕只是一串订单号。"
  },
  {
    "id": "p2-04",
    "scene": "P2",
    "text": "货到了另发一条到货短信——短信是独立消息，不占名额、不改订单。"
  },
  {
    "id": "p2-05",
    "scene": "P2",
    "text": "麻烦在慢命令：谁决定它去后台？",
    "beatStart": true
  },
  {
    "id": "p2-06",
    "scene": "P2",
    "text": "第一道闸门看师傅点没点头：要后台的拨杆打了勾，直接放行。"
  },
  {
    "id": "p2-07",
    "scene": "P2",
    "text": "第二道是兜底：没人要求时，看命令里有没有暗示耗时的词。"
  },
  {
    "id": "p2-08",
    "scene": "P2",
    "text": "教学版列了十一个慢关键词，从安装、构建到测试，命中就猜它是慢活。"
  },
  {
    "id": "p2-09",
    "scene": "P2",
    "text": "有个容易漏看的细节：显式说「不要后台」，挡不住这道兜底。"
  },
  {
    "id": "p2-10",
    "scene": "P2",
    "text": "决定后台化，装置立刻做三件事。",
    "beatStart": true
  },
  {
    "id": "p2-11",
    "scene": "P2",
    "text": "第一，把命令交给一条后台流水线去跑，程序退出时它跟着退。"
  },
  {
    "id": "p2-12",
    "scene": "P2",
    "text": "第二，发个四位编号，头一个零零零一，状态记进登记表。"
  },
  {
    "id": "p2-13",
    "scene": "P2",
    "text": "登记表上着锁：一次只许一方改，几条流水线也不会写乱。"
  },
  {
    "id": "p2-14",
    "scene": "P2",
    "text": "第三，马上回一张占位回执：任务已启动，结果完成后可得。",
    "beatStart": true
  },
  {
    "id": "p2-15",
    "scene": "P2",
    "text": "师傅拿到回执，知道活还在跑，转头就能干别的。"
  },
  {
    "id": "p2-16",
    "scene": "P2",
    "text": "真结果怎么回来？跑完后包装成一条任务通知。",
    "beatStart": true
  },
  {
    "id": "p2-17",
    "scene": "P2",
    "text": "通知是固定样式的标签块：任务号、状态、原命令、摘要。"
  },
  {
    "id": "p2-18",
    "scene": "P2",
    "text": "摘要只留前两百字，再长的构建日志也只剩开头。"
  },
  {
    "id": "p2-19",
    "scene": "P2",
    "text": "送通知进对话的，不是别人，正是主循环自己。"
  },
  {
    "id": "p2-20",
    "scene": "P2",
    "text": "每轮工具执行完、结果交回之前，它顺手查一遍登记表。"
  },
  {
    "id": "p2-21",
    "scene": "P2",
    "text": "顺手查出来的通知和这轮的工具结果，合进同一条消息送进去。"
  },
  {
    "id": "p2-22",
    "scene": "P2",
    "text": "师傅像收到一条新消息一样读到它——这就是叫号器。"
  },
  {
    "id": "p2-23",
    "scene": "P2",
    "text": "走个真实剧本：第一回合，师傅发起安装依赖，丢后台。",
    "beatStart": true
  },
  {
    "id": "p2-24",
    "scene": "P2",
    "text": "循环回占位回执，师傅接着安排别的活。"
  },
  {
    "id": "p2-25",
    "scene": "P2",
    "text": "第二回合，他读配置文件，快命令当场拿内容。"
  },
  {
    "id": "p2-26",
    "scene": "P2",
    "text": "同时安装完成——安装通知和文件内容，同框出现。"
  },
  {
    "id": "p2-27",
    "scene": "P2",
    "text": "师傅一分钟都没干等。"
  },
  {
    "id": "p2-28",
    "scene": "P2",
    "text": "一张回执守住名额，一条通知送回真结果——第一台装置讲完了。"
  },
  {
    "id": "p2-29",
    "scene": "P2",
    "text": "官方产品还多一层：完成的活先存着排队，哪轮有空哪轮送。"
  },
  {
    "id": "p2-30",
    "scene": "P2",
    "text": "接下来是第二台装置——它管的是时间。"
  },
  {
    "id": "p3-01",
    "scene": "P3",
    "text": "墙上的定时钟，要解决「到点」和「有空」两件事。",
    "beatStart": true
  },
  {
    "id": "p3-02",
    "scene": "P3",
    "text": "教学版的答案：把这座钟拆给四个角色，叠成四层。"
  },
  {
    "id": "p3-03",
    "scene": "P3",
    "text": "判时的是条小流水线：每秒看一次表，只管时间不管师傅。"
  },
  {
    "id": "p3-04",
    "scene": "P3",
    "text": "到点的任务先进队列——队列只是账本，不执行任何东西。"
  },
  {
    "id": "p3-05",
    "scene": "P3",
    "text": "交付的流水线看两头：队列有活吗？师傅空闲吗？"
  },
  {
    "id": "p3-06",
    "scene": "P3",
    "text": "像一间医院：排班表定几点看谁，候诊屏排队。",
    "beatStart": true
  },
  {
    "id": "p3-07",
    "scene": "P3",
    "text": "护士见诊室空了才叫人，医生接诊——排班表从不关心医生忙不忙。"
  },
  {
    "id": "p3-08",
    "scene": "P3",
    "text": "这个比方到此为止：医院能加急插队，教学版的队列没有优先级。"
  },
  {
    "id": "p3-09",
    "scene": "P3",
    "text": "最后一环是执行：师傅像收到消息一样，从队列取活开工。"
  },
  {
    "id": "p3-10",
    "scene": "P3",
    "text": "每个任务带一段定时表达式，五段：分、时、日、月、星期。",
    "beatStart": true
  },
  {
    "id": "p3-11",
    "scene": "P3",
    "text": "Unix 用了五十年的写法：数字定死、星号任意、可写范围和间隔。"
  },
  {
    "id": "p3-12",
    "scene": "P3",
    "text": "每天九点、每五分钟、工作日九点，三行表达式写完。"
  },
  {
    "id": "p3-13",
    "scene": "P3",
    "text": "五段里有反直觉的一条：日和星期这对，两个都写死时，任一命中就触发。"
  },
  {
    "id": "p3-14",
    "scene": "P3",
    "text": "像条家规：周末或者下雨天才能吃零食——写进去的两个条件，碰上一个就够。"
  },
  {
    "id": "p3-15",
    "scene": "P3",
    "text": "就拿九月二十八号、恰逢礼拜一的那天举例。"
  },
  {
    "id": "p3-16",
    "scene": "P3",
    "text": "表达式九点、日写一、星期写一——那天照样响：日位没中，星期位中了。"
  },
  {
    "id": "p3-17",
    "scene": "P3",
    "text": "而且反过来也一样：每月一号的九点，它也会响。"
  },
  {
    "id": "p3-18",
    "scene": "P3",
    "text": "判时流水线每秒醒一次，靠三道保险活着。",
    "beatStart": true
  },
  {
    "id": "p3-19",
    "scene": "P3",
    "text": "第一道，去重记号要带日期。"
  },
  {
    "id": "p3-20",
    "scene": "P3",
    "text": "每秒看表，同一分钟会看到六十次，得记下「这分钟触发过了」。"
  },
  {
    "id": "p3-21",
    "scene": "P3",
    "text": "记号只写几点几分，每日任务第二天就被昨天挡住，从此只跑一天。"
  },
  {
    "id": "p3-22",
    "scene": "P3",
    "text": "第二道，单任务兜错：一条坏任务只记它自己的错，流水线继续活。"
  },
  {
    "id": "p3-23",
    "scene": "P3",
    "text": "第三道，注册和加载双重校验，非法表达式进不来，坏存档也拖不垮启动。"
  },
  {
    "id": "p3-24",
    "scene": "P3",
    "text": "交付流水线的循环只有六行。",
    "beatStart": true
  },
  {
    "id": "p3-25",
    "scene": "P3",
    "text": "队列空，先走；抢锁抢不到——说明师傅正忙——也走开。"
  },
  {
    "id": "p3-26",
    "scene": "P3",
    "text": "像敲单人卫生间的门：里面有动静就走，过零点二秒再来，不堵在门口死等。"
  },
  {
    "id": "p3-27",
    "scene": "P3",
    "text": "为什么走开不等？抢不到锁本身就是答案：师傅忙，此刻不该交付。"
  },
  {
    "id": "p3-28",
    "scene": "P3",
    "text": "抢到锁还要再确认一次队列非空，才拉起一轮执行。"
  },
  {
    "id": "p3-29",
    "scene": "P3",
    "text": "走一遍全周期：启动，从磁盘恢复存档任务，两条流水线起步。"
  },
  {
    "id": "p3-30",
    "scene": "P3",
    "text": "两分钟后判时命中、入队，交付流水线见师傅空闲，注入一条定时消息。"
  },
  {
    "id": "p3-31",
    "scene": "P3",
    "text": "师傅像收到指令一样开工——全程没人碰过键盘。"
  },
  {
    "id": "p4-01",
    "scene": "P4",
    "text": "定时钟还有个旋钮：任务存不存盘。",
    "beatStart": true
  },
  {
    "id": "p4-02",
    "scene": "P4",
    "text": "存盘的写进本地文件，重启后加载恢复；不存盘的只活在内存里。"
  },
  {
    "id": "p4-03",
    "scene": "P4",
    "text": "这里藏着全片最容易误解的前提。"
  },
  {
    "id": "p4-04",
    "scene": "P4",
    "text": "调度器，活在这个程序自己的进程里。"
  },
  {
    "id": "p4-05",
    "scene": "P4",
    "text": "进程就是正在运行的那个程序；一关，调度跟着停。",
    "beatStart": true
  },
  {
    "id": "p4-06",
    "scene": "P4",
    "text": "存盘只意味着任务定义还在，下次启动，调度器才会发现该触发了。"
  },
  {
    "id": "p4-07",
    "scene": "P4",
    "text": "想要应用关着也能定时跑？答案不在它身上。"
  },
  {
    "id": "p4-08",
    "scene": "P4",
    "text": "官方文档把边界画得更细：会话任务是默认形态，关终端就停。"
  },
  {
    "id": "p4-09",
    "scene": "P4",
    "text": "恢复会话时任务跟着回来，但四类例外：自定节奏、后台、过期、错过。"
  },
  {
    "id": "p4-10",
    "scene": "P4",
    "text": "跨会话保留的任务文件，复制到别的目录后只列出来、不执行。"
  },
  {
    "id": "p4-11",
    "scene": "P4",
    "text": "要无人值守，官方指了三条路：云上的例程、桌面端本地任务、代码仓库的自动化。",
    "beatStart": true
  },
  {
    "id": "p4-12",
    "scene": "P4",
    "text": "官方还排了张对比表：云端、桌面、会话内，比开机、开会话、碰本地文件。"
  },
  {
    "id": "p4-13",
    "scene": "P4",
    "text": "彩蛋：教学版代码一导入，调度流水线就自己启动。"
  },
  {
    "id": "p4-14",
    "scene": "P4",
    "text": "同一个项目的另一条路线，导入却不起流水线——两边明摆相反。"
  },
  {
    "id": "p4-15",
    "scene": "P4",
    "text": "两台装置讲完了。接下来，进实验室。"
  },
  {
    "id": "p5-01",
    "scene": "P5",
    "text": "现在回到开头那句话：拆掉一个零件，它换一种死法。",
    "beatStart": true
  },
  {
    "id": "p5-02",
    "scene": "P5",
    "text": "实验台上有五个开关，每个拔掉一个零件。"
  },
  {
    "id": "p5-03",
    "scene": "P5",
    "text": "实验规则：一次只拆一个，真跑、记数、对比。"
  },
  {
    "id": "p5-04",
    "scene": "P5",
    "text": "绿色是机制在位的基线，红色是拆掉之后。"
  },
  {
    "id": "p5-05",
    "scene": "P5",
    "text": "第一个开关，拆掉单任务兜错。",
    "beatStart": true
  },
  {
    "id": "p5-06",
    "scene": "P5",
    "text": "一条写坏的毒任务进来：基线里只记它自己的错，流水线还活着。"
  },
  {
    "id": "p5-07",
    "scene": "P5",
    "text": "拆掉兜错，流水线当场死，定时全部停摆——触发数从二归零。"
  },
  {
    "id": "p5-08",
    "scene": "P5",
    "text": "一条坏任务，杀死的不是自己，是整面钟。"
  },
  {
    "id": "p5-09",
    "scene": "P5",
    "text": "第二个开关，把去重记号里的日期抹掉。",
    "beatStart": true
  },
  {
    "id": "p5-10",
    "scene": "P5",
    "text": "当天一切正常；第二天九点，每日任务哑火——被昨天的记号挡住了。"
  },
  {
    "id": "p5-11",
    "scene": "P5",
    "text": "第三个开关，把日和星期的「或」改成「且」。",
    "beatStart": true
  },
  {
    "id": "p5-12",
    "scene": "P5",
    "text": "按直觉改的，对吧？该触发的日子，静默漏掉，一响都没有。"
  },
  {
    "id": "p5-13",
    "scene": "P5",
    "text": "这条「或」，是 Unix 五十年攒下的语义，直觉在这儿不值钱。"
  },
  {
    "id": "p5-14",
    "scene": "P5",
    "text": "第四个开关，交付流水线无视忙锁，硬往对话里塞消息。",
    "beatStart": true
  },
  {
    "id": "p5-15",
    "scene": "P5",
    "text": "基线让行五次；拆掉后零次——消息插进了正在进行的一轮。"
  },
  {
    "id": "p5-16",
    "scene": "P5",
    "text": "同一时刻两方往对话里写——单写者规矩当场破，谁也说不清对话归谁。"
  },
  {
    "id": "p5-17",
    "scene": "P5",
    "text": "第五个开关，拔掉关键词兜底。",
    "beatStart": true
  },
  {
    "id": "p5-18",
    "scene": "P5",
    "text": "师傅忘了说丢后台，装框架的慢命令就在前台干等。"
  },
  {
    "id": "p5-19",
    "scene": "P5",
    "text": "基线阻塞零秒，拆掉后六百秒——十分钟白等，计费照跑。"
  },
  {
    "id": "p5-20",
    "scene": "P5",
    "text": "五个零件，五种死法，没有一个是多余的。"
  },
  {
    "id": "p5-21",
    "scene": "P5",
    "text": "实验室里还埋着两处「照着写就会翻车」。",
    "beatStart": true
  },
  {
    "id": "p5-22",
    "scene": "P5",
    "text": "后台跑的活也没躲过两分钟限时：装框架十分钟的例子，其实跑不完。"
  },
  {
    "id": "p5-23",
    "scene": "P5",
    "text": "两分钟一到，通知里带回的是一行超时错误。"
  },
  {
    "id": "p5-24",
    "scene": "P5",
    "text": "摘要一律截两百字，冗长的构建日志只剩开头。"
  },
  {
    "id": "p5-25",
    "scene": "P5",
    "text": "教学版没有真正解决它自己举的例子。"
  },
  {
    "id": "p5-26",
    "scene": "P5",
    "text": "那官方产品呢？把两边摆上桌——一半印证，一半翻案。"
  },
  {
    "id": "p6-01",
    "scene": "P6",
    "text": "印证不少：建、查、删三件套，一会话五十个、七天过期，官方逐条在册。",
    "beatStart": true
  },
  {
    "id": "p6-02",
    "scene": "P6",
    "text": "调度细节也对上了：每秒检查、低优先级入队、只在两轮对话之间触发。"
  },
  {
    "id": "p6-03",
    "scene": "P6",
    "text": "再说翻案的，最硬的一条是抖动。"
  },
  {
    "id": "p6-04",
    "scene": "P6",
    "text": "抖动——防一窝蜂同时请求，调度器给每个任务的触发时间加固定偏移。"
  },
  {
    "id": "p6-05",
    "scene": "P6",
    "text": "偏移上限对不上：一边说不超过间隔的百分之十，封顶十五分钟。"
  },
  {
    "id": "p6-06",
    "scene": "P6",
    "text": "另一边说三十分钟、或者间隔之半。闭源之下无法裁决，以官方为准。"
  },
  {
    "id": "p6-07",
    "scene": "P6",
    "text": "还有官方写了、教学版没讲的：后台化其实有三条路。",
    "beatStart": true
  },
  {
    "id": "p6-08",
    "scene": "P6",
    "text": "师傅开口之外，人能按键把跑着的命令转后台；跑满两分钟还会自动转。"
  },
  {
    "id": "p6-09",
    "scene": "P6",
    "text": "对，还是那个两分钟——教学版当错误上限，官方产品当转后台的门槛。"
  },
  {
    "id": "p6-10",
    "scene": "P6",
    "text": "另有输出五个 G 就熔断、内存吃紧就收割这类生产护栏，文档都在册。"
  },
  {
    "id": "p6-11",
    "scene": "P6",
    "text": "桌角还坐着位学徒——这条要说明，来自别人对闭源实现的拆解。",
    "beatStart": true
  },
  {
    "id": "p6-12",
    "scene": "P6",
    "text": "他说：后台命令四十五秒没动静，学徒就去瞧一眼，防它悄悄卡死。"
  },
  {
    "id": "p6-13",
    "scene": "P6",
    "text": "账本之外，留两个真争议：谁该决定命令去后台？定时任务该活多久？"
  },
  {
    "id": "p6-14",
    "scene": "P6",
    "text": "就说定时任务：传统防漏跑、官方防烧钱——防的东西不同，只能分档。"
  },
  {
    "id": "p6-15",
    "scene": "P6",
    "text": "最后收成五条规律。",
    "beatStart": true
  },
  {
    "id": "p6-16",
    "scene": "P6",
    "text": "慢结果以新消息进场不赊账；周期工作归装置持有，不靠记性。"
  },
  {
    "id": "p6-17",
    "scene": "P6",
    "text": "队列吸收「到点但没空」；固定偏移摊开峰值；坏输入只损失自己。"
  },
  {
    "id": "p6-18",
    "scene": "P6",
    "text": "边界：它管一个师傅、一个程序；多个师傅开工是另一场戏。"
  },
  {
    "id": "p6-19",
    "scene": "P6",
    "text": "一张回执，一台四层钟——等，被赶出了传送带。下期见。"
  }
]
