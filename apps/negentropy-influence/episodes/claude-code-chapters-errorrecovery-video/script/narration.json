[
  {
    "id": "p0-01",
    "scene": "P0",
    "text": "这是一段一出错就当场停摆的程序。",
    "beatStart": true
  },
  {
    "id": "p0-02",
    "scene": "P0",
    "text": "任务跑到一半，一句报错，循环就停了。"
  },
  {
    "id": "p0-03",
    "scene": "P0",
    "text": "一个不处理错误的程序，就像一辆一碰就熄火的车。"
  },
  {
    "id": "p0-04",
    "scene": "P0",
    "text": "遇到服务端过载，它的应对只有一招：崩。"
  },
  {
    "id": "p0-05",
    "scene": "P0",
    "text": "不重试、不换路，也不减上下文。"
  },
  {
    "id": "p0-06",
    "scene": "P0",
    "text": "可在生产环境，报错从来是常态。",
    "beatStart": true
  },
  {
    "id": "p0-07",
    "scene": "P0",
    "text": "输出被截断、上下文超限、请求被限流、服务端过载。"
  },
  {
    "id": "p0-08",
    "scene": "P0",
    "text": "四类报错，三种缺法——缺额度、缺空间、欠时间。"
  },
  {
    "id": "p0-09",
    "scene": "P0",
    "text": "解法不是永不出错，而是错了怎么办——分类恢复，循环不亡。",
    "beatStart": true
  },
  {
    "id": "p0-10",
    "scene": "P0",
    "text": "三条退路怎么走？先拆骨架。"
  },
  {
    "id": "p1-01",
    "scene": "P1",
    "text": "骨架：调用模型这一步，被包进一层「先试、出错接住」的保护壳。",
    "beatStart": true
  },
  {
    "id": "p1-02",
    "scene": "P1",
    "text": "接住之后先分类，再选路；救回来，就回到循环开头接着跑。"
  },
  {
    "id": "p1-03",
    "scene": "P1",
    "text": "第一类，截断：模型一次能写的量有额度，写到一半就用光了。",
    "beatStart": true
  },
  {
    "id": "p1-04",
    "scene": "P1",
    "text": "第一招升额度：从八千直接升到六万四，原样重发。"
  },
  {
    "id": "p1-05",
    "scene": "P1",
    "text": "被截断的半截先不带上，请求保持干净。"
  },
  {
    "id": "p1-06",
    "scene": "P1",
    "text": "还不够？存下半截，注入续写提示：从断点继续，不道歉不复述。"
  },
  {
    "id": "p1-07",
    "scene": "P1",
    "text": "第二类，超限：请求本身太大，装不下了。",
    "beatStart": true
  },
  {
    "id": "p1-08",
    "scene": "P1",
    "text": "动作是压缩：只留尾部五条消息，压完再试。"
  },
  {
    "id": "p1-09",
    "scene": "P1",
    "text": "只压一次；再超限就退出——再压，也不会变小。"
  },
  {
    "id": "p1-10",
    "scene": "P1",
    "text": "第三类，瞬态：限流、过载，等一等就能好的错。",
    "beatStart": true
  },
  {
    "id": "p1-11",
    "scene": "P1",
    "text": "等待是指数退避：半秒起步，每次翻倍，封顶三十二秒。"
  },
  {
    "id": "p1-12",
    "scene": "P1",
    "text": "再叠一点随机抖动，让并发请求别挤在同一秒重试。",
    "beatStart": true
  },
  {
    "id": "p1-13",
    "scene": "P1",
    "text": "服务器建议等多久就等多久；连续三次过载，切到备用模型。"
  },
  {
    "id": "p1-14",
    "scene": "P1",
    "text": "真到事上，这套分类管不管用？"
  },
  {
    "id": "p2-01",
    "scene": "P2",
    "text": "上实测：给教学版循环喂一组剧本——过载、过载、限流，第四次放行。",
    "beatStart": true
  },
  {
    "id": "p2-02",
    "scene": "P2",
    "text": "它就等：第一次等半秒多，往后每次翻倍。"
  },
  {
    "id": "p2-03",
    "scene": "P2",
    "text": "三次等下来共耗三点七秒，第四次成功——循环没断，模型没换。"
  },
  {
    "id": "p2-04",
    "scene": "P2",
    "text": "换个剧本：过载连来三次——第三次一到就切换，备用模型接着干。"
  },
  {
    "id": "p2-05",
    "scene": "P2",
    "text": "再换：超限。压缩一次，消息从九条收到六条，零秒恢复。",
    "beatStart": true
  },
  {
    "id": "p2-06",
    "scene": "P2",
    "text": "截断：八千升到六万四还不够，就续写，三次收尾。"
  },
  {
    "id": "p2-07",
    "scene": "P2",
    "text": "四个剧本都没杀死循环——可这套分类，真缺不得吗？"
  },
  {
    "id": "p3-01",
    "scene": "P3",
    "text": "破坏实验来了：拆掉分类，所有错误一刀切，统统当成瞬态——原样重发。",
    "beatStart": true
  },
  {
    "id": "p3-02",
    "scene": "P3",
    "text": "先拿最硬的来试：超限。"
  },
  {
    "id": "p3-03",
    "scene": "P3",
    "text": "重试一次，撞墙；再试，还是撞墙——重试到十次上限，十次全撞。",
    "beatStart": true
  },
  {
    "id": "p3-04",
    "scene": "P3",
    "text": "白等一百七十五点六秒，以失败告终。"
  },
  {
    "id": "p3-05",
    "scene": "P3",
    "text": "对照组走分类路径：压缩一次，零秒恢复。"
  },
  {
    "id": "p3-06",
    "scene": "P3",
    "text": "差别在错误的本性：超限是容量错误——请求太大，窗口装不下。",
    "beatStart": true
  },
  {
    "id": "p3-07",
    "scene": "P3",
    "text": "重试，不会让请求变小，只会把时间烧光。"
  },
  {
    "id": "p3-08",
    "scene": "P3",
    "text": "所以救超限，先减规模，再谈重试。"
  },
  {
    "id": "p3-09",
    "scene": "P3",
    "text": "分类不是锦上添花，是循环的存亡线。"
  },
  {
    "id": "p3-10",
    "scene": "P3",
    "text": "教学版都这么狠了，真实的 Claude Code 呢？"
  },
  {
    "id": "p4-01",
    "scene": "P4",
    "text": "拆解过 Claude Code 源码的同学们应该知道：每轮结束，结局判定有十几种。",
    "beatStart": true
  },
  {
    "id": "p4-02",
    "scene": "P4",
    "text": "教学版只展开五种。"
  },
  {
    "id": "p4-02b",
    "scene": "P4",
    "text": "续写还带边际检查——连续三次增量太小，直接判停。"
  },
  {
    "id": "p4-03",
    "scene": "P4",
    "text": "同一套骨架的另一个实现版本，参数换了档。",
    "beatStart": true
  },
  {
    "id": "p4-04",
    "scene": "P4",
    "text": "额度只升到一万六、重试三次、两次过载就切换。"
  },
  {
    "id": "p4-05",
    "scene": "P4",
    "text": "哪组对？都对：激进多给机会，成功率优先；保守早失败，延迟与成本优先。"
  },
  {
    "id": "p4-06",
    "scene": "P4",
    "text": "两组常数并存，恰恰说明：这些数是调出来的，不是机制必然。",
    "beatStart": true
  },
  {
    "id": "p4-07",
    "scene": "P4",
    "text": "骨架是机制，预算是选择——这一切，能收成一句话。"
  },
  {
    "id": "p5-01",
    "scene": "P5",
    "text": "收成一句话：错误按类型分径，每条路径都有上界。",
    "beatStart": true
  },
  {
    "id": "p5-02",
    "scene": "P5",
    "text": "升级一次、续写三次、压缩一次、重试十次——有界，防的是救援变死循环。"
  },
  {
    "id": "p5-03",
    "scene": "P5",
    "text": "有句话正好作结：错误不是终点，是重试的起点。"
  },
  {
    "id": "p5-04",
    "scene": "P5",
    "text": "循环是不死了。可还有个更早的隐患：大目标从不写进文件，只留在模型的记忆里。",
    "beatStart": true
  },
  {
    "id": "p5-05",
    "scene": "P5",
    "text": "任务越长，丢得越快——这个隐患，下期拆。"
  },
  {
    "id": "p5-06",
    "scene": "P5",
    "text": "最后交代来源：这套视频的内容，改编自开源课程 Learn Claude Code。",
    "beatStart": true,
    "ttsText": "最后交代来源：这套视频的内容，改编自开源课程 <Learn|L ER1 N> <Claude|K L AO1 D> <Code|K OW1 D>。"
  },
  {
    "id": "p5-07",
    "scene": "P5",
    "text": "今天的生产细节，来自原作者的单方核查，没锁版本，计数会漂移。"
  }
]
