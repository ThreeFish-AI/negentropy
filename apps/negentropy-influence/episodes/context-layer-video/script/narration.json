[
  {
    "id": "p0-01",
    "scene": "P0",
    "text": "你身边可能也有个常用的 AI 助手。"
  },
  {
    "id": "p0-02",
    "scene": "P0",
    "text": "帮写周报、润色邮件，它表现利索。"
  },
  {
    "id": "p0-03",
    "scene": "P0",
    "text": "但只要让它查公司数据，立刻变得很悬。"
  },
  {
    "id": "p0-04",
    "scene": "P0",
    "text": "问上月活跃用户多少，它要么不敢答，要么瞎编。"
  },
  {
    "id": "p0-05",
    "scene": "P0",
    "text": "分析师一针见血：直连数据库的 AI，只是个连接良好的猜测器。"
  },
  {
    "id": "p0-06",
    "scene": "P0",
    "text": "它没有入职第一天，每次被唤醒都在从零猜黑话。"
  },
  {
    "id": "p0-07",
    "scene": "P0",
    "text": "大厂把含义做成重型套件，中小团队很难照搬。"
  },
  {
    "id": "p0-08",
    "scene": "P0",
    "text": "这集我们把市政蓝图抽出来，拆成五块通用积木。"
  },
  {
    "id": "p0-09",
    "scene": "P0",
    "text": "每一块积木，都在纯标准库代码里验证过。"
  },
  {
    "id": "p0-10",
    "scene": "P0",
    "text": "看看自己动手，怎么给 AI 搭出一座可信的城。"
  },
  {
    "id": "p1-01",
    "scene": "P1",
    "text": "给数据世界修一座城，先理清五大市政系统。"
  },
  {
    "id": "p1-02",
    "scene": "P1",
    "text": "第一套是地籍册即对象层，决定城里放什么。"
  },
  {
    "id": "p1-03",
    "scene": "P1",
    "text": "指标、字段、文档技能与权限，都是受治理对象。"
  },
  {
    "id": "p1-04",
    "scene": "P1",
    "text": "第二套是门牌索引即目录层，决定怎么找。"
  },
  {
    "id": "p1-05",
    "scene": "P1",
    "text": "它给全城拉一张总账，指回原处，引用不复制。"
  },
  {
    "id": "p1-06",
    "scene": "P1",
    "text": "第三套是规划局即富化层，决定城怎么养。"
  },
  {
    "id": "p1-07",
    "scene": "P1",
    "text": "兼顾官方修志与民间近道，让定义变厚变准。"
  },
  {
    "id": "p1-08",
    "scene": "P1",
    "text": "第四套是在路上执勤的门禁，即治理层，决定怎么信。"
  },
  {
    "id": "p1-09",
    "scene": "P1",
    "text": "角色权限、出口安检与威胁，都在这关执行。"
  },
  {
    "id": "p1-10",
    "scene": "P1",
    "text": "第五套是国标插座与问询台，即激活层，决定怎么用。"
  },
  {
    "id": "p1-11",
    "scene": "P1",
    "text": "智能体插上插头，拿到的都是受治理上下文。"
  },
  {
    "id": "p1-12",
    "scene": "P1",
    "text": "五大系统核心原则，是正交。"
  },
  {
    "id": "p1-13",
    "scene": "P1",
    "text": "行业格局里，获得城有四条路线。"
  },
  {
    "id": "p1-14",
    "scene": "P1",
    "text": "生在城里的平台内嵌，治理在引擎内但绑定大厂。"
  },
  {
    "id": "p1-15",
    "scene": "P1",
    "text": "按图纸盖的定义即代码，治理在转换层但脱离运行。"
  },
  {
    "id": "p1-16",
    "scene": "P1",
    "text": "只画地图的元数据平面，被批只描述不执行。"
  },
  {
    "id": "p1-17",
    "scene": "P1",
    "text": "异类 Palantir 把动态动作也铸进本体。"
  },
  {
    "id": "p1-18",
    "scene": "P1",
    "text": "蓝图选第三条路：可独立部署的可执行层。"
  },
  {
    "id": "p1-19",
    "scene": "P1",
    "text": "关键把治理挪到查询生成前，防嵌套绕行。"
  },
  {
    "id": "p1-20",
    "scene": "P1",
    "text": "正交意味着解耦：换门牌系统不需要重修路。"
  },
  {
    "id": "p1-21",
    "scene": "P1",
    "text": "每一层独立演进，城才不会牵一发动全身。"
  },
  {
    "id": "p1-22",
    "scene": "P1",
    "text": "这张市政总图，就是接下来的施工地图。"
  },
  {
    "id": "p2-01",
    "scene": "P2",
    "text": "施工第一步，建对象层这本地籍册。"
  },
  {
    "id": "p2-02",
    "scene": "P2",
    "text": "城市铁律：没登记的地皮绝不许开工。"
  },
  {
    "id": "p2-03",
    "scene": "P2",
    "text": "定义泛化为对象，并立下三条字段纪律。"
  },
  {
    "id": "p2-04",
    "scene": "P2",
    "text": "第一，同义词必须当成一等资产填写。"
  },
  {
    "id": "p2-05",
    "scene": "P2",
    "text": "没同义词的定义，在检索面上完全是隐形的。"
  },
  {
    "id": "p2-06",
    "scene": "P2",
    "text": "第二，给智能体的说明书必须随对象走。"
  },
  {
    "id": "p2-07",
    "scene": "P2",
    "text": "规则随定义演进，不硬编码在外部提示词里。"
  },
  {
    "id": "p2-08",
    "scene": "P2",
    "text": "第三，人工核准的问答必须附带签署溯源。"
  },
  {
    "id": "p2-09",
    "scene": "P2",
    "text": "每个对象登记时，必经严格结构校验门。"
  },
  {
    "id": "p2-10",
    "scene": "P2",
    "text": "引用必须命中键约束，非法结构注册期拒之门外。"
  },
  {
    "id": "p2-11",
    "scene": "P2",
    "text": "每个词条都有一生，对应严密状态机。"
  },
  {
    "id": "p2-12",
    "scene": "P2",
    "text": "从草稿态起步，经校验与评审晋升治理态。"
  },
  {
    "id": "p2-13",
    "scene": "P2",
    "text": "同名异义进冲突态，被新版取代转废弃态。"
  },
  {
    "id": "p2-14",
    "scene": "P2",
    "text": "对象还携带数据契约与严格弃用纪律。"
  },
  {
    "id": "p2-15",
    "scene": "P2",
    "text": "变更必走弃用窗口通知，严禁静默改口径。"
  },
  {
    "id": "p2-16",
    "scene": "P2",
    "text": "接着是第二块积木：门牌索引即目录层。"
  },
  {
    "id": "p2-17",
    "scene": "P2",
    "text": "市政职责是立门牌，绝不替各家各户盖楼。"
  },
  {
    "id": "p2-18",
    "scene": "P2",
    "text": "目录是逻辑视图，汇聚各源头元数据指针。"
  },
  {
    "id": "p2-19",
    "scene": "P2",
    "text": "全城只有一本账，出现第二本就会精神分裂。"
  },
  {
    "id": "p2-20",
    "scene": "P2",
    "text": "目录里沉淀着四层活信号。"
  },
  {
    "id": "p2-21",
    "scene": "P2",
    "text": "结构记录字段血缘，运维记录新鲜与健康。"
  },
  {
    "id": "p2-22",
    "scene": "P2",
    "text": "语义记录口径本体，行为记录频次与热度。"
  },
  {
    "id": "p2-23",
    "scene": "P2",
    "text": "静态图谱记是什么，上下文图谱记演变与使用。"
  },
  {
    "id": "p2-24",
    "scene": "P2",
    "text": "目录承诺：只做元数据联邦，永不碰数据行。"
  },
  {
    "id": "p2-25",
    "scene": "P2",
    "text": "来源受限无法合并，退化为路由不落地数据。"
  },
  {
    "id": "p2-26",
    "scene": "P2",
    "text": "地籍册界定含义，门牌索引打通寻址路径。"
  },
  {
    "id": "p2-27",
    "scene": "P2",
    "text": "实体和街道，到这里被清晰地锚定下来。"
  },
  {
    "id": "p2-28",
    "scene": "P2",
    "text": "城市有了基座，接下来要给它注入活水。"
  },
  {
    "id": "p2-29",
    "scene": "P2",
    "text": "把散落各处的经验，源源不断养进城里。"
  },
  {
    "id": "p2-30",
    "scene": "P2",
    "text": "这就轮到了规划局出场。"
  },
  {
    "id": "p3-01",
    "scene": "P3",
    "text": "任何城光靠专家关门规划，赶不上城市生长。"
  },
  {
    "id": "p3-02",
    "scene": "P3",
    "text": "实测显示上万张表里，人工手册覆盖不到百分之五。"
  },
  {
    "id": "p3-03",
    "scene": "P3",
    "text": "这就必须靠富化层双轨：显式轨道与隐式轨道。"
  },
  {
    "id": "p3-04",
    "scene": "P3",
    "text": "显式轨道是官方修志，权威打满，机器辅助起草。"
  },
  {
    "id": "p3-05",
    "scene": "P3",
    "text": "机器起草人类盖章，建模从数天压至数分钟。"
  },
  {
    "id": "p3-06",
    "scene": "P3",
    "text": "隐式轨道则是观察人们实际踩出来的近道。"
  },
  {
    "id": "p3-07",
    "scene": "P3",
    "text": "从真实日志、看板调用痕迹提取长尾经验。"
  },
  {
    "id": "p3-08",
    "scene": "P3",
    "text": "隐式口径权威较低，作为候选条目进入目录。"
  },
  {
    "id": "p3-09",
    "scene": "P3",
    "text": "后台挂着自纠环：拿金标准与反馈跑自动化测试。"
  },
  {
    "id": "p3-10",
    "scene": "P3",
    "text": "发现语义错配补同义词，检索偏航微调热度。"
  },
  {
    "id": "p3-11",
    "scene": "P3",
    "text": "缺口榜直接转化成工作清单，驱动城市自愈。"
  },
  {
    "id": "p3-12",
    "scene": "P3",
    "text": "但近道要转正，必须面对最关键的冲突处理。"
  },
  {
    "id": "p3-13",
    "scene": "P3",
    "text": "比如两部门对活跃用户这词，各有不同算法。"
  },
  {
    "id": "p3-14",
    "scene": "P3",
    "text": "当两本志书打架，系统该听谁的？"
  },
  {
    "id": "p3-15",
    "scene": "P3",
    "text": "很多团队犯过大错：让机器按热度自动选择。"
  },
  {
    "id": "p3-16",
    "scene": "P3",
    "text": "蓝图锁死核心契约：冲突必须浮出听证会。"
  },
  {
    "id": "p3-17",
    "scene": "P3",
    "text": "一旦同名异义，两份定义双双标上冲突。"
  },
  {
    "id": "p3-18",
    "scene": "P3",
    "text": "问询接口返回冲突卡，并列两定义，数值刻意空白。"
  },
  {
    "id": "p3-19",
    "scene": "P3",
    "text": "D4 破坏性实验清晰复现了这种风险。"
  },
  {
    "id": "p3-20",
    "scene": "P3",
    "text": "一旦按热度自动选，错误口径就会借调用量胜出。"
  },
  {
    "id": "p3-21",
    "scene": "P3",
    "text": "活跃数直接翻倍，四百七十七对四十八事故即由此来。"
  },
  {
    "id": "p3-22",
    "scene": "P3",
    "text": "错误胜出比直接报错危险十倍，因为极其隐蔽。"
  },
  {
    "id": "p3-23",
    "scene": "P3",
    "text": "机器绝不能假装共识，裁决权必须交还责任人。"
  },
  {
    "id": "p3-24",
    "scene": "P3",
    "text": "听证会由人定夺，胜者转正，败者归档。"
  },
  {
    "id": "p3-25",
    "scene": "P3",
    "text": "规矩立在台面，城市才不会从内部腐烂。"
  },
  {
    "id": "p3-26",
    "scene": "P3",
    "text": "养好上下文后，下一步是把它安全开放出去。"
  },
  {
    "id": "p4-01",
    "scene": "P4",
    "text": "激活层是对外窗口，由问询台与国标插座组成。"
  },
  {
    "id": "p4-02",
    "scene": "P4",
    "text": "问询台是所有智能体交互的唯一入口。"
  },
  {
    "id": "p4-03",
    "scene": "P4",
    "text": "契约极其克制：绝不把整座档案库倒在桌上。"
  },
  {
    "id": "p4-04",
    "scene": "P4",
    "text": "只递出相关两页，附带盖章人、新鲜度与冲突提示。"
  },
  {
    "id": "p4-05",
    "scene": "P4",
    "text": "排序融合四路信号：相关度、权威度、热度与新鲜度。"
  },
  {
    "id": "p4-06",
    "scene": "P4",
    "text": "热度采用对数变换封顶，防止某些高频查询刷榜。"
  },
  {
    "id": "p4-07",
    "scene": "P4",
    "text": "命中核准题直接短路重放，无覆盖诚实告警。"
  },
  {
    "id": "p4-08",
    "scene": "P4",
    "text": "对外联通手段，就是模型上下文协议 MCP。"
  },
  {
    "id": "p4-09",
    "scene": "P4",
    "text": "业界金句：MCP 是传输层，语义层是逻辑层。"
  },
  {
    "id": "p4-10",
    "scene": "P4",
    "text": "把插头当成上下文，等于把电话线当成对话本身。"
  },
  {
    "id": "p4-11",
    "scene": "P4",
    "text": "蓝图把上下文层封装成标准 MCP 供给面。"
  },
  {
    "id": "p4-12",
    "scene": "P4",
    "text": "在开源原型里，纯标准库实现了四个标准工具。"
  },
  {
    "id": "p4-13",
    "scene": "P4",
    "text": "列举目录条目、解析问询包、编译指标与反馈热度。"
  },
  {
    "id": "p4-14",
    "scene": "P4",
    "text": "外部智能体插上插头，立刻获得整座城支撑。"
  },
  {
    "id": "p4-15",
    "scene": "P4",
    "text": "开放互操作有三重边界：可携带不等于可执行与已验证。"
  },
  {
    "id": "p4-16",
    "scene": "P4",
    "text": "带着定义走，别家引擎未必替你执行规则。"
  },
  {
    "id": "p4-17",
    "scene": "P4",
    "text": "把城市开放为口岸后，攻击面被急剧放大。"
  },
  {
    "id": "p4-18",
    "scene": "P4",
    "text": "必须在插座前设海关检疫，防御四大真实威胁。"
  },
  {
    "id": "p4-19",
    "scene": "P4",
    "text": "第一类是工具描述投毒，注释里偷藏指令诱导失控。"
  },
  {
    "id": "p4-20",
    "scene": "P4",
    "text": "第二类是间接注入，外部文档被误当成执行指令。"
  },
  {
    "id": "p4-21",
    "scene": "P4",
    "text": "第三类是混淆提权，诱骗高权限服务端越权查数。"
  },
  {
    "id": "p4-22",
    "scene": "P4",
    "text": "第四类是认证凭证透传与盗用。"
  },
  {
    "id": "p4-23",
    "scene": "P4",
    "text": "现实中恶意伪造服务暗中抄送，官方工具被曝漏洞。"
  },
  {
    "id": "p4-24",
    "scene": "P4",
    "text": "惨痛教训显示：官方受信组件也必须当不可信输入。"
  },
  {
    "id": "p4-25",
    "scene": "P4",
    "text": "海关检疫必须落实七项硬核控制。"
  },
  {
    "id": "p4-26",
    "scene": "P4",
    "text": "工具定义钉住哈希，防事后偷改行为。"
  },
  {
    "id": "p4-27",
    "scene": "P4",
    "text": "拆分读写工具，严禁一把梭的万能接口。"
  },
  {
    "id": "p4-28",
    "scene": "P4",
    "text": "破坏性与资金外发操作，强制人工二次确认。"
  },
  {
    "id": "p4-29",
    "scene": "P4",
    "text": "监控响应内容，隐藏的指令式语言拉响警报。"
  },
  {
    "id": "p4-30",
    "scene": "P4",
    "text": "出口配网络白名单，限制爆炸半径，凭证短命轮转。"
  },
  {
    "id": "p4-31",
    "scene": "P4",
    "text": "加上此前验证的双层防线，编译期封死绕行漏洞。"
  },
  {
    "id": "p4-32",
    "scene": "P4",
    "text": "既有标准插座开箱即用，又有海关检疫寸步不让。"
  },
  {
    "id": "p4-33",
    "scene": "P4",
    "text": "智能体无论怎么调用，始终处在受治理的笼子里。"
  },
  {
    "id": "p4-34",
    "scene": "P4",
    "text": "城市通路贯通，最后给工程建质检标尺与运营制度。"
  },
  {
    "id": "p5-01",
    "scene": "P5",
    "text": "任何严肃的工程，都必须正视自己的能力边界。"
  },
  {
    "id": "p5-02",
    "scene": "P5",
    "text": "这一章直面最尖锐的问题：图纸验收合格，救得了地基塌方吗？"
  },
  {
    "id": "p5-03",
    "scene": "P5",
    "text": "答案依然救不了：治理保图纸合法，救不了上游粒度塌陷。"
  },
  {
    "id": "p5-04",
    "scene": "P5",
    "text": "蓝图给出了三级对策。"
  },
  {
    "id": "p5-05",
    "scene": "P5",
    "text": "第一级，在表达式注册期自动识别非可加性，成本最低，先做。"
  },
  {
    "id": "p5-06",
    "scene": "P5",
    "text": "第二级，用核准问答作为出口对账资产，重算不一致当场报警。"
  },
  {
    "id": "p5-07",
    "scene": "P5",
    "text": "第三级，用自动化评测环事后打分，沿血缘定位源头。"
  },
  {
    "id": "p5-08",
    "scene": "P5",
    "text": "怎么知道整套系统真的有效？市政工程必须有严格的定期年检。"
  },
  {
    "id": "p5-09",
    "scene": "P5",
    "text": "业界实测显示，教科书式的基准测试在企业真实复杂场景前全面失效。"
  },
  {
    "id": "p5-10",
    "scene": "P5",
    "text": "真实企业基准下，最强大模型表现跌到了百分之二十一点三。"
  },
  {
    "id": "p5-11",
    "scene": "P5",
    "text": "高校审计发现，许多公开基准黄金答案错误率超六成。"
  },
  {
    "id": "p5-12",
    "scene": "P5",
    "text": "连公开考卷都在犯错，企业绝不能盲目迷信外部榜单。"
  },
  {
    "id": "p5-13",
    "scene": "P5",
    "text": "年检必须由业务团队亲自出题，期望值必须有人签字核准。"
  },
  {
    "id": "p5-14",
    "scene": "P5",
    "text": "考卷不仅要考正常查询，还要派便衣警察故意发起越权闯红灯用例。"
  },
  {
    "id": "p5-15",
    "scene": "P5",
    "text": "系统的第一原则永远是：报错优于错数。"
  },
  {
    "id": "p5-16",
    "scene": "P5",
    "text": "拒绝回答并留审计，远好过自信给出一个错数。"
  },
  {
    "id": "p5-17",
    "scene": "P5",
    "text": "考卷活起来之后，整座城市的日常运转，归结为人与组织的运营。"
  },
  {
    "id": "p5-18",
    "scene": "P5",
    "text": "一座城，不能谁来了都能给街道命名。"
  },
  {
    "id": "p5-19",
    "scene": "P5",
    "text": "命名权必须集中，提案权应当开放，使用权必须普惠。"
  },
  {
    "id": "p5-20",
    "scene": "P5",
    "text": "业务团队是最终拍板人，数据团队负责起草测试与流程运转。"
  },
  {
    "id": "p5-21",
    "scene": "P5",
    "text": "提案、起草、测试、评审、发布，每一步留下完整审计痕迹。"
  },
  {
    "id": "p5-22",
    "scene": "P5",
    "text": "纵观三十年失败史，许多项目最后沦为无人维护空城。"
  },
  {
    "id": "p5-23",
    "scene": "P5",
    "text": "核心败因在于不在执行路径，做成了表演性术语剧场。"
  },
  {
    "id": "p5-24",
    "scene": "P5",
    "text": "避坑的第一处方，是从五个核心指标起步。"
  },
  {
    "id": "p5-25",
    "scene": "P5",
    "text": "找有权高管亲自站台，拍定这五个词在公司就这意思。"
  },
  {
    "id": "p5-26",
    "scene": "P5",
    "text": "把五个指标打磨成可执行的日常基础设施，逐步生根发芽。"
  },
  {
    "id": "p5-27",
    "scene": "P5",
    "text": "日常运营依靠城市仪表盘的三个刻度。"
  },
  {
    "id": "p5-28",
    "scene": "P5",
    "text": "覆盖缺口榜紧盯哪些未纳管词条被频繁问起，指引富化方向。"
  },
  {
    "id": "p5-29",
    "scene": "P5",
    "text": "命中率衡量受信任资产的日常活跃度。"
  },
  {
    "id": "p5-30",
    "scene": "P5",
    "text": "越权拒绝率证明门禁正在坚决履职，而不是系统故障。"
  },
  {
    "id": "p5-31",
    "scene": "P5",
    "text": "制度、评测与指标咬合在一起，城市才能长久健康地呼吸。"
  },
  {
    "id": "p6-01",
    "scene": "P6",
    "text": "总结我们的建造历程，蓝图设计了一条清晰的四阶演进路线。"
  },
  {
    "id": "p6-02",
    "scene": "P6",
    "text": "第零阶段机制验证，核心机制与破坏性实验已全部跑通。"
  },
  {
    "id": "p6-03",
    "scene": "P6",
    "text": "第一阶段搭最小服务，接真实智能体，跑通拦截与审计。"
  },
  {
    "id": "p6-04",
    "scene": "P6",
    "text": "第二阶段完善信任自纠，听证会常态化，沉淀问答资产。"
  },
  {
    "id": "p6-05",
    "scene": "P6",
    "text": "第三阶段互操作升级，支持跨平台格式转换与角色隔离。"
  },
  {
    "id": "p6-06",
    "scene": "P6",
    "text": "这条演进线给每个技术团队提供了一个可脚踏实地的施工指南。"
  },
  {
    "id": "p6-07",
    "scene": "P6",
    "text": "回顾整座城市的建设，我们想留下三点理性思考。"
  },
  {
    "id": "p6-08",
    "scene": "P6",
    "text": "第一，上下文层绝不是塞给大模型的某种补品或临时插件。"
  },
  {
    "id": "p6-09",
    "scene": "P6",
    "text": "它是像数据库、像网络协议一样，必须严肃建设的新型基础设施。"
  },
  {
    "id": "p6-10",
    "scene": "P6",
    "text": "第二，城修多大，完全取决于你要养多少智能体。"
  },
  {
    "id": "p6-11",
    "scene": "P6",
    "text": "团队只有两个助手，把地籍册和前台做好就足够产生乘数效应。"
  },
  {
    "id": "p6-12",
    "scene": "P6",
    "text": "面对复杂跨业务流，才需要把五大系统全套铺满。"
  },
  {
    "id": "p6-13",
    "scene": "P6",
    "text": "循序渐进，拒绝一开始就搞过度治理的空心蓝图。"
  },
  {
    "id": "p6-14",
    "scene": "P6",
    "text": "第三，大模型技术还在一日千里地向前狂奔。"
  },
  {
    "id": "p6-15",
    "scene": "P6",
    "text": "但不管两三年后模型推理能力翻多少倍，数据库里的乱码列名依然不会自动消失。"
  },
  {
    "id": "p6-16",
    "scene": "P6",
    "text": "业务指标的定义权，永远属于人类组织本身，属于真实的商业契约。"
  },
  {
    "id": "p6-17",
    "scene": "P6",
    "text": "含义的供给方式，才是决定 AI 落地生死的真正瓶颈。"
  },
  {
    "id": "p6-18",
    "scene": "P6",
    "text": "记住那句警醒全行业的工程箴言。"
  },
  {
    "id": "p6-19",
    "scene": "P6",
    "text": "在含义真正被严肃治理好之前，AI 展现出来的所有聪明，都只是从概率里租来的。"
  },
  {
    "id": "p6-20",
    "scene": "P6",
    "text": "给它修一座有秩序的城，它才能从一个流浪的猜测者，变成真正守规矩的拓荒人。"
  }
]
