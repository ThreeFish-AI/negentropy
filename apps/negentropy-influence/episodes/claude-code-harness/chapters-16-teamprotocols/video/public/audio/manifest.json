[
 {
  "id": "p0-01",
  "scene": "P0",
  "text": "这是一句差点闯祸的「行」：答应过，和真的办妥，是两回事。",
  "beatStart": true,
  "blockStart": true,
  "cue": {
   "emo": "surprised:0.15"
  },
  "ttsText": "这是一句差点闯祸的「行」——答应过，和真的办妥，是两回事。",
  "durationSec": 5.175
 },
 {
  "id": "p0-02",
  "scene": "P0",
  "text": "队友一多，口信满天飞——最悬的，就是那句「行」。",
  "durationSec": 4.426
 },
 {
  "id": "p0-03",
  "scene": "P0",
  "text": "最要命的两件事：关机，和审批。",
  "beatStart": true,
  "blockStart": true,
  "cue": {
   "emo": "melancholic:0.12"
  },
  "durationSec": 2.975
 },
 {
  "id": "p0-04",
  "scene": "P0",
  "text": "想让队友停下，直接掐掉？写一半的文件当场悬空。",
  "durationSec": 4.71
 },
 {
  "id": "p0-05",
  "scene": "P0",
  "text": "所以关机要先商量：发请求，等对方收尾回话，再动手。",
  "blockStart": true,
  "cue": {
   "emo": "calm:0.10"
  },
  "durationSec": 4.84
 },
 {
  "id": "p0-06",
  "scene": "P0",
  "text": "审批同款：动高风险的活，先报计划，批了才动手。",
  "durationSec": 4.45
 },
 {
  "id": "p0-07",
  "scene": "P0",
  "text": "一方发请求，一方给回复——这笔账，靠口信记不住。",
  "beatStart": true,
  "blockStart": true,
  "cue": {
   "emo": "afraid:0.10"
  },
  "durationSec": 5.12
 },
 {
  "id": "p0-08",
  "scene": "P0",
  "text": "口信会漏、会认错单，同一句「行」还算两回。",
  "durationSec": 3.141
 },
 {
  "id": "p0-09",
  "scene": "P0",
  "text": "今天的答案，是一本一单一号的账。",
  "blockStart": true,
  "cue": {
   "emo": "calm:0.12"
  },
  "durationSec": 3.524
 },
 {
  "id": "p1-01",
  "scene": "P1",
  "text": "答案，是一张登记表。",
  "beatStart": true,
  "blockStart": true,
  "cue": {
   "emo": "calm:0.10"
  },
  "durationSec": 2.02
 },
 {
  "id": "p1-02",
  "scene": "P1",
  "text": "每单协商，先开一张请求单，领一个号。",
  "durationSec": 3.703
 },
 {
  "id": "p1-03",
  "scene": "P1",
  "text": "单上记着：编号、类型、发给谁，和状态。",
  "blockStart": true,
  "cue": {
   "emo": "surprised:0.10"
  },
  "durationSec": 4.41
 },
 {
  "id": "p1-04",
  "scene": "P1",
  "text": "状态只有三种：待处理、已批准、已拒绝。",
  "durationSec": 3.979
 },
 {
  "id": "p1-05",
  "scene": "P1",
  "text": "像一本回执簿：开单、等回执、按编号销账——对上号，才算办结。",
  "beatStart": true,
  "blockStart": true,
  "cue": {
   "emo": "calm:0.08"
  },
  "durationSec": 6.14
 },
 {
  "id": "p1-06",
  "scene": "P1",
  "text": "边界说死：簿子不担保对方一定回——它管销账，不管催账。",
  "durationSec": 5.081
 },
 {
  "id": "p1-07",
  "scene": "P1",
  "text": "答应没答应、办没办结，从此看表说话。",
  "beatStart": true,
  "blockStart": true,
  "cue": {
   "emo": "happy:0.10"
  },
  "durationSec": 4.07
 },
 {
  "id": "p1-08",
  "scene": "P1",
  "text": "这本账怎么转？拿一单关机，走四步。",
  "durationSec": 3.457
 },
 {
  "id": "p2-01",
  "scene": "P2",
  "text": "第一步，开单：领号 142，类型关机，发队友甲，先记待处理。",
  "beatStart": true,
  "blockStart": true,
  "cue": {
   "emo": "calm:0.10"
  },
  "durationSec": 5.06
 },
 {
  "id": "p2-02",
  "scene": "P2",
  "text": "第二步，投递：请求进甲的收件箱；一看类型是关机，甲先收尾。",
  "durationSec": 5.098
 },
 {
  "id": "p2-03",
  "scene": "P2",
  "text": "第三步，回执：甲回一条回复，带回同一个 142 号和同意与否。",
  "beatStart": true,
  "blockStart": true,
  "cue": {
   "emo": "calm:0.08"
  },
  "durationSec": 5.51
 },
 {
  "id": "p2-04",
  "scene": "P2",
  "text": "第四步，销账：翻表对号，才把状态改成批准或拒绝。",
  "ttsText": "第四步，销账——翻表对号，才把状态改成批准，或拒绝。",
  "durationSec": 4.83
 },
 {
  "id": "p2-05",
  "scene": "P2",
  "text": "账一销，甲收摊退场——这单协商闭环了。",
  "durationSec": 3.636
 },
 {
  "id": "p2-06",
  "scene": "P2",
  "text": "换成审批，一个字不用改：同一张表，同一套状态。",
  "beatStart": true,
  "blockStart": true,
  "cue": {
   "emo": "surprised:0.12"
  },
  "durationSec": 4.01
 },
 {
  "id": "p2-06b",
  "scene": "P2",
  "text": "这张对上号才改状态的表，行话叫协议状态机。",
  "ttsText": "这张对上号才改状态的表，<行|HANG2>话叫协议状态机。",
  "durationSec": 3.27
 },
 {
  "id": "p2-07",
  "scene": "P2",
  "text": "加新协商？不造新机器，多开一个类型分支就够。",
  "beatStart": true,
  "durationSec": 4.021
 },
 {
  "id": "p2-08",
  "scene": "P2",
  "text": "听着挺稳？「对号」两个字里，还藏着三道检查。",
  "blockStart": true,
  "cue": {
   "emo": "calm:0.12"
  },
  "durationSec": 4.812
 },
 {
  "id": "p3-01",
  "scene": "P3",
  "text": "销账那一刻，三道检查挨个过，一道拦一种错。",
  "beatStart": true,
  "blockStart": true,
  "cue": {
   "emo": "calm:0.10"
  },
  "durationSec": 4.25
 },
 {
  "id": "p3-02",
  "scene": "P3",
  "text": "第一道查编号：号在表上没有？不理——拦住认错单的回复。",
  "durationSec": 4.848
 },
 {
  "id": "p3-03",
  "scene": "P3",
  "text": "第二道查类型：类型对不上？不理——关机的回复，批不动计划的单。",
  "blockStart": true,
  "cue": {
   "emo": "calm:0.08"
  },
  "durationSec": 5.3
 },
 {
  "id": "p3-04",
  "scene": "P3",
  "text": "第三道查状态：这单已办结？不理——同一句话，不许生效两次。",
  "durationSec": 5.54
 },
 {
  "id": "p3-05",
  "scene": "P3",
  "text": "嫌它死板？实测说话：把第二道拆了，编号照留。",
  "beatStart": true,
  "blockStart": true,
  "cue": {
   "emo": "afraid:0.16"
  },
  "durationSec": 4.28
 },
 {
  "id": "p3-06",
  "scene": "P3",
  "text": "一条关机回复，把一单挂着的计划审批，硬改成已批准。",
  "ttsText": "一条关机回复，把一单挂着的计划审批，硬改成，已批准！",
  "durationSec": 5.14
 },
 {
  "id": "p3-07",
  "scene": "P3",
  "text": "编号对上，只是找对了单；类型对上，才是同一件事。",
  "durationSec": 3.444
 },
 {
  "id": "p3-08",
  "scene": "P3",
  "text": "第三道也拆过：关掉状态检查，同一条「同意」投两遍。",
  "beatStart": true,
  "blockStart": true,
  "cue": {
   "emo": "afraid:0.14"
  },
  "durationSec": 4.705
 },
 {
  "id": "p3-09",
  "scene": "P3",
  "text": "表被改写两次；再投一条反话，已批准当场翻成已拒绝。",
  "ttsText": "表被改写两次；再投一条反话——已批准，当场翻成已拒绝！",
  "durationSec": 4.78
 },
 {
  "id": "p3-10",
  "scene": "P3",
  "text": "一个请求，只决议一次——这条底线，第三道兜着。",
  "blockStart": true,
  "cue": {
   "emo": "calm:0.15"
  },
  "durationSec": 4.41
 },
 {
  "id": "p3-11",
  "scene": "P3",
  "text": "三道齐了就万无一失？还有个更隐蔽的坑：谁来读那条回复。",
  "durationSec": 5.307
 },
 {
  "id": "p4-01",
  "scene": "P4",
  "text": "坑就在那只收件箱：规矩还是那条。信，取走就没了。",
  "beatStart": true,
  "blockStart": true,
  "cue": {
   "emo": "calm:0.10"
  },
  "durationSec": 4.24
 },
 {
  "id": "p4-02",
  "scene": "P4",
  "text": "查信的工具、还有循环本身，各读各的：先读的拿走回复，账，一笔没销。",
  "durationSec": 5.21
 },
 {
  "id": "p4-03",
  "scene": "P4",
  "text": "实测就坏成这样：关机那单，永远销不了——再去看，箱子空了。",
  "durationSec": 5.526
 },
 {
  "id": "p4-04",
  "scene": "P4",
  "text": "解法一句话：读即消费，单点入口。进门先销账，再把信交给对话。",
  "blockStart": true,
  "cue": {
   "emo": "calm:0.12"
  },
  "ttsText": "解法一句话——读即消费，单点入口！进门先销账，再把信交给对话。",
  "durationSec": 6.368
 },
 {
  "id": "p4-05",
  "scene": "P4",
  "text": "那真实的 Claude Code 呢？这一路的请求单和回复，那边叫什么？",
  "beatStart": true,
  "blockStart": true,
  "cue": {
   "emo": "surprised:0.12"
  },
  "durationSec": 4.93
 },
 {
  "id": "p4-06",
  "scene": "P4",
  "text": "拆解过 Claude Code 源码的同学们应该知道：叫协议消息，格式不对就拒收，一共十五种。",
  "durationSec": 6.865
 },
 {
  "id": "p4-07",
  "scene": "P4",
  "text": "关机是三向的：请求、批准，或拒绝附理由，再补一条系统通知。",
  "blockStart": true,
  "cue": {
   "emo": "calm:0.08"
  },
  "durationSec": 6.043
 },
 {
  "id": "p4-08",
  "scene": "P4",
  "text": "咱们这台教学版，自己承认：没有执行闸门。批没批，靠自觉。",
  "beatStart": true,
  "blockStart": true,
  "cue": {
   "emo": "melancholic:0.10"
  },
  "durationSec": 5.175
 },
 {
  "id": "p4-09",
  "scene": "P4",
  "text": "同一门课的新版补了闸：没批准，跑命令写文件直接被挡回；认领新任务，旧批文作废。",
  "durationSec": 6.864
 },
 {
  "id": "p4-10",
  "scene": "P4",
  "text": "闸门拦到哪层才算够？两边还在争——往下，用一条原则收账。",
  "blockStart": true,
  "cue": {
   "emo": "calm:0.12"
  },
  "durationSec": 6.008
 },
 {
  "id": "p5-01",
  "scene": "P5",
  "text": "一句话收束：关键协商，不靠自觉，靠协议状态机。",
  "beatStart": true,
  "blockStart": true,
  "cue": {
   "emo": "calm:0.15"
  },
  "ttsText": "一句话收束：关键协商，不靠自觉，靠，协议状态机。",
  "durationSec": 5.521
 },
 {
  "id": "p5-02",
  "scene": "P5",
  "text": "口头的「行」会漏、会认错单、会重复生效——这三样，登记表全兜住。",
  "blockStart": true,
  "cue": {
   "emo": "calm:0.12"
  },
  "durationSec": 5.78
 },
 {
  "id": "p5-03",
  "scene": "P5",
  "text": "主代理和队友，都只是协议的参与者；对错，由结构兜底。",
  "durationSec": 5.32
 },
 {
  "id": "p5-03b",
  "scene": "P5",
  "text": "翻开那本回执簿：开单、等回执、按编号销账——对上号，才算数。",
  "blockStart": true,
  "cue": {
   "emo": "happy:0.10"
  },
  "ttsText": "翻开那本回执簿——开单、等回执、按编号销账。对上号，才算数！",
  "durationSec": 6.171
 },
 {
  "id": "p5-04",
  "scene": "P5",
  "text": "只是一桩事还没解：活，至今是主代理挨个派。",
  "beatStart": true,
  "blockStart": true,
  "cue": {
   "emo": "melancholic:0.12"
  },
  "durationSec": 4.08
 },
 {
  "id": "p5-05",
  "scene": "P5",
  "text": "队伍一大，派活先成瓶颈——下期，没人派活。",
  "durationSec": 4.441
 },
 {
  "id": "p5-06",
  "scene": "P5",
  "text": "最后交代来源：这套视频的内容，改编自开源课程 Learn Claude Code。",
  "beatStart": true,
  "ttsText": "最后交代来源：这套视频的内容，改编自开源课程 <Learn|L ER1 N> <Claude|K L AO1 D> <Code|K OW1 D>。",
  "blockStart": true,
  "cue": {
   "emo": "calm:0.10"
  },
  "durationSec": 6.171
 },
 {
  "id": "p5-07",
  "scene": "P5",
  "text": "今天的生产细节，来自原作者的单方核查，没锁版本，计数会漂移。",
  "cue": {
   "emo": "calm:0.10"
  },
  "durationSec": 6.043
 }
]
