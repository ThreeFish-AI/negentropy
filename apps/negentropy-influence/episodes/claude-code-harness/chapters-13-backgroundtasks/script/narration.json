[
  {
    "id": "p0-01",
    "scene": "P0",
    "text": "这是一条能把整个循环，卡在原地干等的命令。",
    "beatStart": true
  },
  {
    "id": "p0-02",
    "scene": "P0",
    "text": "读个文件，眨眼就完；装一套依赖，十分钟能跑满。"
  },
  {
    "id": "p0-03",
    "scene": "P0",
    "text": "这十分钟，模型一步动不了，按文字量计费，空转也在花钱。"
  },
  {
    "id": "p0-04",
    "scene": "P0",
    "text": "可没人会站在洗衣机前，盯满三十分钟。",
    "beatStart": true
  },
  {
    "id": "p0-05",
    "scene": "P0",
    "text": "衣服扔进去，按下启动就走人——好了，它自己提醒。"
  },
  {
    "id": "p0-06",
    "scene": "P0",
    "text": "循环也该这样：慢命令丢出去，结果自己回来。",
    "beatStart": true
  },
  {
    "id": "p0-07",
    "scene": "P0",
    "text": "只差一步——对话的规矩，不答应。"
  },
  {
    "id": "p1-01",
    "scene": "P1",
    "text": "对话协议有条硬规矩：一次调用，只配一个结果。",
    "beatStart": true
  },
  {
    "id": "p1-02",
    "scene": "P1",
    "text": "名额就一个：等它跑完是干等；先回再补，是违规。"
  },
  {
    "id": "p1-03",
    "scene": "P1",
    "text": "解法是丢后台——可谁说了算，哪条命令算慢？两道闸门来把关。",
    "beatStart": true
  },
  {
    "id": "p1-04",
    "scene": "P1",
    "text": "第一道看模型：参数明写了要后台，直接放行。"
  },
  {
    "id": "p1-05",
    "scene": "P1",
    "text": "第二道是兜底：模型没开口，就翻命令找字眼。"
  },
  {
    "id": "p1-06",
    "scene": "P1",
    "text": "安装、构建、测试这类词一撞上，就猜它是慢操作。"
  },
  {
    "id": "p1-07",
    "scene": "P1",
    "text": "容易漏看的细节：明说「不要后台」，也拦不住这道兜底。"
  },
  {
    "id": "p1-08",
    "scene": "P1",
    "text": "实测说话：拔掉兜底，同条安装命令落回原地干等——主循环从零秒一路卡到六百秒。",
    "beatStart": true
  },
  {
    "id": "p1-09",
    "scene": "P1",
    "text": "模型忘说一句「丢后台」，代价就是十分钟全程陪等。"
  },
  {
    "id": "p1-10",
    "scene": "P1",
    "text": "可就算进了后台，真结果要怎么进对话？名额只有一个。"
  },
  {
    "id": "p2-01",
    "scene": "P2",
    "text": "决定后台化，循环当场做三件事。",
    "beatStart": true
  },
  {
    "id": "p2-02",
    "scene": "P2",
    "text": "第一，交给后台线程，程序里另开的一条并行执行线。"
  },
  {
    "id": "p2-03",
    "scene": "P2",
    "text": "第二，发编号：从零零零一递增，状态记进登记表。"
  },
  {
    "id": "p2-04",
    "scene": "P2",
    "text": "第三，马上回占位回执：任务已启动，结果完成后可得。"
  },
  {
    "id": "p2-05",
    "scene": "P2",
    "text": "像点单取餐：店员先递小票，订单当场闭合。",
    "beatStart": true
  },
  {
    "id": "p2-06",
    "scene": "P2",
    "text": "餐好了叫号广播，那是新事件，没人收回小票重写。"
  },
  {
    "id": "p2-07",
    "scene": "P2",
    "text": "边界：小票丢了还能凭记忆取；名额用掉，就是用掉了。"
  },
  {
    "id": "p2-08",
    "scene": "P2",
    "text": "模型拿着占位转头干下一件，真结果在后台赶路。"
  },
  {
    "id": "p3-01",
    "scene": "P3",
    "text": "后台跑完，真结果怎么回来？不补旧账。",
    "beatStart": true
  },
  {
    "id": "p3-02",
    "scene": "P3",
    "text": "它被包成一条独立通知：任务号、状态、原命令，加一段摘要。"
  },
  {
    "id": "p3-03",
    "scene": "P3",
    "text": "摘要最长两百字——再长的输出，也只留开头。"
  },
  {
    "id": "p3-04",
    "scene": "P3",
    "text": "送它进对话的是主循环自己：每轮交结果前，顺手查一遍登记表。"
  },
  {
    "id": "p3-05",
    "scene": "P3",
    "text": "做完的，收进通知，跟当轮结果合进同一条消息送进对话。"
  },
  {
    "id": "p3-06",
    "scene": "P3",
    "text": "第一回合：模型发起安装命令，带上了后台参数。",
    "beatStart": true
  },
  {
    "id": "p3-07",
    "scene": "P3",
    "text": "循环回占位回执；模型顺势预告，要把配置文件也读了。"
  },
  {
    "id": "p3-08",
    "scene": "P3",
    "text": "第二回合：读配置是快命令，当场拿到内容。"
  },
  {
    "id": "p3-09",
    "scene": "P3",
    "text": "主循环顺手收集后台结果，安装通知和配置内容同框出现。"
  },
  {
    "id": "p3-10",
    "scene": "P3",
    "text": "从发起到收尾，主循环一分钟都没干等——路通了，坎还在后头。"
  },
  {
    "id": "p4-01",
    "scene": "P4",
    "text": "教学版有道坎，实测在场：丢进后台的命令，最多只给两分钟。",
    "beatStart": true
  },
  {
    "id": "p4-02",
    "scene": "P4",
    "text": "开篇那条十分钟安装的例子，教学版撑不完：两分钟超时收场。"
  },
  {
    "id": "p4-03",
    "scene": "P4",
    "text": "生产版自己留了后手：命令跑满超时，自动转后台。",
    "beatStart": true
  },
  {
    "id": "p4-04",
    "scene": "P4",
    "text": "同一个两分钟：教学版当错误上限，生产版当转后台的触发线。"
  },
  {
    "id": "p4-05",
    "scene": "P4",
    "text": "谁该决定「去后台」？成了真争议。",
    "beatStart": true
  },
  {
    "id": "p4-06",
    "scene": "P4",
    "text": "模型知道意图，命令文本里露出线索，系统握着实际耗时。"
  },
  {
    "id": "p4-07",
    "scene": "P4",
    "text": "新版教学代码删掉了兜底：不再按关键词猜，只认明确决定。"
  },
  {
    "id": "p4-08",
    "scene": "P4",
    "text": "可拔掉兜底的代价，你已经见过——就是那六百秒。"
  },
  {
    "id": "p4-09",
    "scene": "P4",
    "text": "更深的误会，还藏在「保存」两个字里。"
  },
  {
    "id": "p5-01",
    "scene": "P5",
    "text": "收尾前一个误会：还有一类到点才跑的任务——定义写进磁盘，调度却活在程序进程里。",
    "beatStart": true
  },
  {
    "id": "p5-02",
    "scene": "P5",
    "text": "进程一关，一切停摆——保住定义，保不住「到点会发生」。"
  },
  {
    "id": "p5-03",
    "scene": "P5",
    "text": "像纸质日程本：计划跨年都在，没人翻开就不会发生。"
  },
  {
    "id": "p5-04",
    "scene": "P5",
    "text": "纸本永远等人翻；任务重启后自动被拾起，下次到点照常触发——停摆错过的，不补跑。"
  },
  {
    "id": "p5-05",
    "scene": "P5",
    "text": "一句话收束：慢操作不能赊账——占位先闭合问答，真结果走新消息进场。",
    "beatStart": true
  },
  {
    "id": "p5-06",
    "scene": "P5",
    "text": "主循环还是那个循环，只是不再傻等。"
  },
  {
    "id": "p5-07",
    "scene": "P5",
    "text": "九点该跑的测试还得人提醒——下期，把「到点」从人手里拿走。",
    "beatStart": true
  },
  {
    "id": "p5-08",
    "scene": "P5",
    "text": "最后交代来源：这套视频的内容，改编自开源课程 Learn Claude Code。",
    "beatStart": true,
    "ttsText": "最后交代来源：这套视频的内容，改编自开源课程 <Learn|L ER1 N> <Claude|K L AO1 D> <Code|K OW1 D>。"
  },
  {
    "id": "p5-09",
    "scene": "P5",
    "text": "今天的生产细节，没锁版本，口径会漂移。"
  }
]
