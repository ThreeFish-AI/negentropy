[
 {
  "id": "p0-01",
  "scene": "P0",
  "text": "这是一堵墙，专治大目标的嘴上接力。",
  "beatStart": true,
  "blockStart": true,
  "cue": {
   "emo": "surprised:0.15"
  },
  "ttsText": "这是一堵墙，专治大目标的，嘴上接力。",
  "durationSec": 3.505
 },
 {
  "id": "p0-02",
  "scene": "P0",
  "text": "大目标拆成几句叮嘱往下传，一句没接住，链就断。",
  "durationSec": 3.335
 },
 {
  "id": "p0-03",
  "scene": "P0",
  "text": "现成的清单工具帮不上忙：记在内存里，换个会话就没了。",
  "durationSec": 5.52
 },
 {
  "id": "p0-04",
  "scene": "P0",
  "text": "它不记依赖——谁该先做；也不记归属——这活归谁管。",
  "beatStart": true,
  "blockStart": true,
  "cue": {
   "emo": "melancholic:0.15"
  },
  "durationSec": 4.49
 },
 {
  "id": "p0-05",
  "scene": "P0",
  "text": "清单写着「初稿还没交」——可排版这个活，现在能不能开工？没人答得上。",
  "durationSec": 7.005
 },
 {
  "id": "p0-06",
  "scene": "P0",
  "text": "大目标要的是落盘：任务写成文件，重启不丢，先后顺序挡在认领前面。",
  "cue": {
   "emo": "melancholic:0.15"
  },
  "durationSec": 7.123
 },
 {
  "id": "p0-07",
  "scene": "P0",
  "text": "今天砌这堵墙：大目标拆成卡，挂上去，人人可认领。",
  "beatStart": true,
  "blockStart": true,
  "cue": {
   "emo": "calm:0.12"
  },
  "durationSec": 4.67
 },
 {
  "id": "p0-08",
  "scene": "P0",
  "text": "先看一块砖——墙上的卡，长什么样。",
  "durationSec": 3.233
 },
 {
  "id": "p1-01",
  "scene": "P1",
  "text": "墙的砖，是一张张任务卡：一个任务，一个文件。",
  "beatStart": true,
  "blockStart": true,
  "cue": {
   "emo": "calm:0.10"
  },
  "durationSec": 3.99
 },
 {
  "id": "p1-02",
  "scene": "P1",
  "text": "卡上六个字段：编号、标题、描述、状态、归属人，还有依赖列表——开工前要等的那些卡。",
  "durationSec": 7.77
 },
 {
  "id": "p1-03",
  "scene": "P1",
  "text": "状态只有三个：待领、在做、完成。",
  "beatStart": true,
  "blockStart": true,
  "cue": {
   "emo": "calm:0.08"
  },
  "durationSec": 2.99
 },
 {
  "id": "p1-04",
  "scene": "P1",
  "text": "两个动作推着走：认领，待领变在做、写下归属人；完成，在做变完成。",
  "durationSec": 6.291
 },
 {
  "id": "p1-05",
  "scene": "P1",
  "text": "认领前有一道关卡：依赖列表里的每个任务，都得是完成。",
  "beatStart": true,
  "blockStart": true,
  "cue": {
   "emo": "afraid:0.10"
  },
  "durationSec": 4.946,
  "blockSplit": "fallback"
 },
 {
  "id": "p1-06",
  "scene": "P1",
  "text": "有一个没完成？不许开工。",
  "ttsText": "有一个没完成？不许开工！",
  "durationSec": 2.914,
  "blockSplit": "fallback"
 },
 {
  "id": "p1-07",
  "scene": "P1",
  "text": "依赖的文件根本不存在？同样挡住——编号引用错了，不放行，也不崩溃。",
  "durationSec": 6.647,
  "blockSplit": "fallback"
 },
 {
  "id": "p1-08",
  "scene": "P1",
  "text": "卡不是纸质便签——是程序能读写的文件，重启了还在。",
  "beatStart": true,
  "blockStart": true,
  "cue": {
   "emo": "surprised:0.12"
  },
  "durationSec": 5.323
 },
 {
  "id": "p1-09",
  "scene": "P1",
  "text": "模型手里的工具，从三件长到八件，新添的五件，全是任务操作。",
  "beatStart": true,
  "blockStart": true,
  "cue": {
   "emo": "happy:0.12"
  },
  "durationSec": 5.37
 },
 {
  "id": "p1-10",
  "scene": "P1",
  "text": "墙砌好了，走个例子，看它怎么转。",
  "durationSec": 2.826
 },
 {
  "id": "p2-01",
  "scene": "P2",
  "text": "走个例子：内容工厂四个任务——写初稿、配图、排版、发布。",
  "beatStart": true,
  "blockStart": true,
  "cue": {
   "emo": "calm:0.10"
  },
  "durationSec": 5.475
 },
 {
  "id": "p2-02",
  "scene": "P2",
  "text": "依赖登记在卡上：排版依赖初稿和配图，发布依赖排版。",
  "durationSec": 4.718
 },
 {
  "id": "p2-03",
  "scene": "P2",
  "text": "上墙一看，能领的只有初稿和配图。",
  "beatStart": true,
  "blockStart": true,
  "cue": {
   "emo": "calm:0.08"
  },
  "durationSec": 3.105
 },
 {
  "id": "p2-04",
  "scene": "P2",
  "text": "排版的依赖没凑齐，发布前面还压着排版。",
  "durationSec": 3.235
 },
 {
  "id": "p2-05",
  "scene": "P2",
  "text": "初稿认领、做完；配图认领、做完。",
  "durationSec": 3.103
 },
 {
  "id": "p2-06",
  "scene": "P2",
  "text": "配图完成，排版的依赖凑齐、关卡抬起——解锁报告点名排版；排版完成，点名发布；发布完成，报：没有。",
  "beatStart": true,
  "blockStart": true,
  "cue": {
   "emo": "happy:0.12"
  },
  "ttsText": "配图完成，排版的依赖凑齐、关卡抬起——解锁报告，点名排版；排版完成，点名发布；发布完成，报：没有。",
  "durationSec": 8.01
 },
 {
  "id": "p2-07",
  "scene": "P2",
  "text": "解锁是主动推送——完成动作自己带回下一份开工名单。",
  "durationSec": 4.281
 },
 {
  "id": "p2-08",
  "scene": "P2",
  "text": "还有个细节：认领，不算完成。",
  "beatStart": true,
  "blockStart": true,
  "cue": {
   "emo": "afraid:0.08"
  },
  "durationSec": 2.79
 },
 {
  "id": "p2-09",
  "scene": "P2",
  "text": "关卡只认完成——谁把活领走却没做完，等在它后面的卡照样被挡着。",
  "durationSec": 5.81
 },
 {
  "id": "p2-10",
  "scene": "P2",
  "text": "四个任务，全部完成。",
  "beatStart": true,
  "blockStart": true,
  "cue": {
   "emo": "happy:0.12"
  },
  "durationSec": 2.815
 },
 {
  "id": "p2-11",
  "scene": "P2",
  "text": "只是墙上还挂着一张怪卡：它依赖的编号，根本不存在。",
  "blockStart": true,
  "cue": {
   "emo": "surprised:0.14"
  },
  "durationSec": 5.37
 },
 {
  "id": "p3-01",
  "scene": "P3",
  "text": "那是张陷阱卡：依赖列表里，写着一个不存在的编号。",
  "beatStart": true,
  "blockStart": true,
  "cue": {
   "emo": "calm:0.10"
  },
  "durationSec": 4.84
 },
 {
  "id": "p3-02",
  "scene": "P3",
  "text": "关卡照章办事：编号不存在，按被挡处理，没人领得走它。",
  "durationSec": 5.399
 },
 {
  "id": "p3-03",
  "scene": "P3",
  "text": "现在拆一个开关：把「不存在视为被挡」，改成「忽略」——别的都不动。",
  "beatStart": true,
  "blockStart": true,
  "cue": {
   "emo": "afraid:0.14"
  },
  "durationSec": 5.33
 },
 {
  "id": "p3-04",
  "scene": "P3",
  "text": "实测当场翻车：陷阱卡被认领——一个幽灵任务上了岗。",
  "ttsText": "实测当场翻车：陷阱卡被认领——一个幽灵任务，上了岗。",
  "durationSec": 4.516
 },
 {
  "id": "p3-05",
  "scene": "P3",
  "text": "麻烦在哪？「不存在」和「未完成」，是两码事。",
  "beatStart": true,
  "blockStart": true,
  "cue": {
   "emo": "calm:0.15"
  },
  "durationSec": 3.37
 },
 {
  "id": "p3-06",
  "scene": "P3",
  "text": "未完成，是活没干完；不存在，多半是编号写错了。",
  "durationSec": 3.96
 },
 {
  "id": "p3-07",
  "scene": "P3",
  "text": "所以这道关卡宁可挡住，也不放行——挡住是晚开工，放行是错上加错。",
  "ttsText": "所以这道关卡宁可挡住，也不放行——挡住，是晚开工；放行，是错上加错。",
  "durationSec": 6.733
 },
 {
  "id": "p3-08",
  "scene": "P3",
  "text": "顺带一句：两个人同时抢同一张卡，怎么办？",
  "beatStart": true,
  "blockStart": true,
  "cue": {
   "emo": "surprised:0.12"
  },
  "durationSec": 3.88
 },
 {
  "id": "p3-09",
  "scene": "P3",
  "text": "看见不等于抢到——答案是一把锁，往后专门讲。",
  "durationSec": 3.885
 },
 {
  "id": "p3-10",
  "scene": "P3",
  "text": "教学版的墙砌完了。真实产品里，它比这重得多。",
  "beatStart": true,
  "blockStart": true,
  "cue": {
   "emo": "calm:0.12"
  },
  "durationSec": 5.045
 },
 {
  "id": "p4-01",
  "scene": "P4",
  "text": "拆解过 Claude Code 源码的同学们应该知道：真实的任务卡有九个字段。",
  "beatStart": true,
  "blockStart": true,
  "cue": {
   "emo": "surprised:0.12"
  },
  "durationSec": 5.565
 },
 {
  "id": "p4-02",
  "scene": "P4",
  "text": "每任务一个文件，躺在用户自己目录下的任务文件夹里。",
  "durationSec": 4.512
 },
 {
  "id": "p4-03",
  "scene": "P4",
  "text": "刚才悬着的那把锁，真实版真的上了——认领上锁，锁里五步：再读一遍、查归属、查完成、查依赖、写归属。",
  "beatStart": true,
  "blockStart": true,
  "cue": {
   "emo": "calm:0.10"
  },
  "durationSec": 8.76
 },
 {
  "id": "p4-04",
  "scene": "P4",
  "text": "锁抢不到就退避重试：最多三十次，等待从五毫秒拉到一百毫秒。",
  "durationSec": 6.294
 },
 {
  "id": "p4-05",
  "scene": "P4",
  "text": "还有个高水位标，记着用过的最大编号——删掉的卡，编号不会被复用。",
  "beatStart": true,
  "blockStart": true,
  "cue": {
   "emo": "surprised:0.10"
  },
  "durationSec": 6.287
 },
 {
  "id": "p4-06",
  "scene": "P4",
  "text": "教学版也没停下——后来的一版，把建图改成两步：先建卡拿编号，再连依赖。",
  "beatStart": true,
  "blockStart": true,
  "cue": {
   "emo": "calm:0.08"
  },
  "durationSec": 6.2
 },
 {
  "id": "p4-07",
  "scene": "P4",
  "text": "为什么？模型一口气发出几个工具调用——同一轮回答里的几个调用，落笔时互相看不见。",
  "durationSec": 6.756
 },
 {
  "id": "p4-08",
  "scene": "P4",
  "text": "后建的卡，拿不到先建卡刚生成的编号。",
  "blockStart": true,
  "cue": {
   "emo": "calm:0.12"
  },
  "durationSec": 3.72
 },
 {
  "id": "p4-09",
  "scene": "P4",
  "text": "这样连出来的依赖，才经得起检查。",
  "durationSec": 2.99
 },
 {
  "id": "p5-01",
  "scene": "P5",
  "text": "一句话收束：该共享的状态，出内存、入文件——重启不丢，人人可看。",
  "beatStart": true,
  "blockStart": true,
  "cue": {
   "emo": "calm:0.15"
  },
  "durationSec": 7.041
 },
 {
  "id": "p5-02",
  "scene": "P5",
  "text": "往后不管是组队还是协商，全都踩着这堵墙。",
  "blockStart": true,
  "cue": {
   "emo": "calm:0.12"
  },
  "durationSec": 4.65
 },
 {
  "id": "p5-03",
  "scene": "P5",
  "text": "只是墙外还有个老麻烦：一条慢命令跑几分钟，循环就停在原地干等。",
  "blockStart": true,
  "cue": {
   "emo": "melancholic:0.12"
  },
  "ttsText": "只是墙外还有个老麻烦：一条慢命令跑几分钟，循环就停在原地，干等。",
  "durationSec": 5.92
 },
 {
  "id": "p5-04",
  "scene": "P5",
  "text": "下期，就从这条慢命令说起。",
  "durationSec": 2.787
 },
 {
  "id": "p5-05",
  "scene": "P5",
  "text": "最后交代来源：这套视频的内容，改编自开源课程 Learn Claude Code。",
  "beatStart": true,
  "ttsText": "最后交代来源：这套视频的内容，改编自开源课程 <Learn|L ER1 N> <Claude|K L AO1 D> <Code|K OW1 D>。",
  "blockStart": true,
  "cue": {
   "emo": "calm:0.10"
  },
  "durationSec": 6.171
 },
 {
  "id": "p5-06",
  "scene": "P5",
  "text": "今天的生产细节，来自原作者的单方核查，没锁版本，计数会漂移。",
  "cue": {
   "emo": "calm:0.10"
  },
  "durationSec": 6.043
 }
]
