[
  {
    "id": "p0-01",
    "scene": "P0",
    "text": "这是一支没人派活、也从不停工的队伍。",
    "beatStart": true
  },
  {
    "id": "p0-02",
    "scene": "P0",
    "text": "老办法：干完一件，站着等队长派下一件。"
  },
  {
    "id": "p0-03",
    "scene": "P0",
    "text": "墙上挂十个任务，就得手动派十次——队伍撑不大。"
  },
  {
    "id": "p0-04",
    "scene": "P0",
    "text": "答案朴素得出奇：自己看板，自己认领。",
    "beatStart": true
  },
  {
    "id": "p0-05",
    "scene": "P0",
    "text": "每个队友身上，装一座值班钟。"
  },
  {
    "id": "p0-06",
    "scene": "P0",
    "text": "空闲了，钟每五秒敲一拍：先看信，再看板，能干的写名领走。"
  },
  {
    "id": "p0-07",
    "scene": "P0",
    "text": "听着万事大吉——偏偏「认领」这一步，藏着最深的坑。"
  },
  {
    "id": "p1-01",
    "scene": "P1",
    "text": "先立全貌：队友的一生就三个状态——干活、空闲、关机。",
    "beatStart": true
  },
  {
    "id": "p1-02",
    "scene": "P1",
    "text": "干活：收信、想、调工具；空闲：不退出也不干等，钟开始敲。"
  },
  {
    "id": "p1-03",
    "scene": "P1",
    "text": "每一拍动作固定：先看收件箱，再看任务墙。",
    "beatStart": true
  },
  {
    "id": "p1-04",
    "scene": "P1",
    "text": "顺序有讲究：关机和点名是冲你来的，晚一步耽误全局。"
  },
  {
    "id": "p1-05",
    "scene": "P1",
    "text": "墙上的活是公共的，晚一轮没关系。"
  },
  {
    "id": "p1-06",
    "scene": "P1",
    "text": "信箱空了才看墙：找没人做、没归属、依赖全完成的卡——缺一条跳过。",
    "beatStart": true
  },
  {
    "id": "p1-07",
    "scene": "P1",
    "text": "找到就写名认领，回干活；找不到，睡到下一拍。"
  },
  {
    "id": "p1-08",
    "scene": "P1",
    "text": "回干活前还有道检查：自己攒下的消息记录短得反常、被压成摘要，就把「我是谁、干什么活」重写一遍。",
    "beatStart": true
  },
  {
    "id": "p1-09",
    "scene": "P1",
    "text": "敲满十二拍、六十秒还没活：发一条总结，收摊走人。",
    "beatStart": true
  },
  {
    "id": "p1-10",
    "scene": "P1",
    "text": "规矩就这么几条——灵不灵，走一遍。"
  },
  {
    "id": "p2-01",
    "scene": "P2",
    "text": "走个例子。内容工厂四件活：初稿、配图、排版、发布。",
    "beatStart": true
  },
  {
    "id": "p2-02",
    "scene": "P2",
    "text": "排版依赖初稿加配图；发布，依赖排版。"
  },
  {
    "id": "p2-03",
    "scene": "P2",
    "text": "队友一交完初稿，钟响：先看信，空的。",
    "beatStart": true
  },
  {
    "id": "p2-04",
    "scene": "P2",
    "text": "再看墙：配图刚被队友二写上名字，不动。"
  },
  {
    "id": "p2-05",
    "scene": "P2",
    "text": "有张陷阱卡：没主没人做，依赖写着不存在的编号——按被挡算，不许开工。"
  },
  {
    "id": "p2-06",
    "scene": "P2",
    "text": "这一拍没活，睡。下一拍，队友二交完配图。",
    "beatStart": true
  },
  {
    "id": "p2-07",
    "scene": "P2",
    "text": "再扫：排版三条全齐——写名，认领，回干活。"
  },
  {
    "id": "p2-08",
    "scene": "P2",
    "text": "四件活全部落地，陷阱卡纹丝不动——没人指挥过一句。",
    "beatStart": true
  },
  {
    "id": "p2-09",
    "scene": "P2",
    "text": "可要是两个队友，同一拍看上同一张卡呢？"
  },
  {
    "id": "p3-01",
    "scene": "P3",
    "text": "最要命的巧合：同一拍，两人扫到同一张空卡。",
    "beatStart": true
  },
  {
    "id": "p3-02",
    "scene": "P3",
    "text": "认领其实是三步：读卡、查归属、写名字。"
  },
  {
    "id": "p3-03",
    "scene": "P3",
    "text": "扫描看到的只是某一时刻的快照；查完到写入，隔着一道窗口。"
  },
  {
    "id": "p3-04",
    "scene": "P3",
    "text": "像电影院线上选座：两个人，同时看到同一个空座。",
    "beatStart": true
  },
  {
    "id": "p3-05",
    "scene": "P3",
    "text": "选座系统把锁座下单做成一步——看见，不等于抢到。"
  },
  {
    "id": "p3-06",
    "scene": "P3",
    "text": "教学版，恰恰没有这把锁。"
  },
  {
    "id": "p3-07",
    "scene": "P3",
    "text": "教学原型上实测：撤掉锁，让两边交错认领。",
    "beatStart": true
  },
  {
    "id": "p3-08",
    "scene": "P3",
    "text": "日志两行：这边写「归属：队友一」，那边写「归属：队友二」。",
    "ttsText": "日志两<行|HANG2>：这边写「归属：队友一」，那边写「归属：队友二」。"
  },
  {
    "id": "p3-09",
    "scene": "P3",
    "text": "双方都以为到手；卡上只留一个名字——后写的那个。"
  },
  {
    "id": "p3-10",
    "scene": "P3",
    "text": "同一件活干两遍，另一边还蒙在鼓里。"
  },
  {
    "id": "p3-11",
    "scene": "P3",
    "text": "把锁装回去重跑：同一个场景，只有一个人成功。"
  },
  {
    "id": "p3-12",
    "scene": "P3",
    "text": "被挡就当没领到，不可怕；无锁交错，连这点感知都没有。",
    "beatStart": true
  },
  {
    "id": "p3-13",
    "scene": "P3",
    "text": "看见不等于抢到，查与写一口气做完——这把锁，谁来上？"
  },
  {
    "id": "p4-01",
    "scene": "P4",
    "text": "补这把锁，另一版做得更完整：发现和认领，拆成两步。",
    "beatStart": true
  },
  {
    "id": "p4-02",
    "scene": "P4",
    "text": "扫描，只负责把卡挑出来；写名字，锁进一次只许一个人进的代码段。"
  },
  {
    "id": "p4-03",
    "scene": "P4",
    "text": "门有两道闩：进程里一把锁，磁盘上一把文件锁。"
  },
  {
    "id": "p4-04",
    "scene": "P4",
    "text": "进门先重读一遍卡，掐死查与写之间的窗口。"
  },
  {
    "id": "p4-05",
    "scene": "P4",
    "text": "拆解过 Claude Code 源码的同学们应该知道：真实版认领，也包在文件锁里。",
    "beatStart": true
  },
  {
    "id": "p4-06",
    "scene": "P4",
    "text": "官方文档也明说：这把锁防的，就是同时抢任务。"
  },
  {
    "id": "p4-07",
    "scene": "P4",
    "text": "重读、查归属、查完成、查依赖、写名字——五步一口气锁完。"
  },
  {
    "id": "p4-08",
    "scene": "P4",
    "text": "抢不到锁就退避重试：最多三十次、五到一百毫秒。"
  },
  {
    "id": "p4-09",
    "scene": "P4",
    "text": "空闲的节奏也快得多：约五百毫秒一轮，还不设固定超时。"
  },
  {
    "id": "p4-10",
    "scene": "P4",
    "text": "闲多久，两版选得不一样：六十秒收工怕空转；长驻等待，怕队友记忆从头重建。",
    "beatStart": true
  },
  {
    "id": "p5-01",
    "scene": "P5",
    "text": "一句话收束：看见不等于抢到——查与写，一口气锁完。",
    "beatStart": true
  },
  {
    "id": "p5-02",
    "scene": "P5",
    "text": "自己看板、自己认领的自由，全靠这把锁兜底。"
  },
  {
    "id": "p5-03",
    "scene": "P5",
    "text": "只是谁干活说清了，在哪干活，还没说。"
  },
  {
    "id": "p5-04",
    "scene": "P5",
    "text": "两个队友同改一个文件，你写的下一行，正踩在别人的改动上。",
    "ttsText": "两个队友同改一个文件，你写的下一<行|HANG2>，正踩在别人的改动上。"
  },
  {
    "id": "p5-05",
    "scene": "P5",
    "text": "下期，接着说这个踩脚的问题。"
  },
  {
    "id": "p5-06",
    "scene": "P5",
    "text": "最后交代来源：这套视频的内容，改编自开源课程 Learn Claude Code。",
    "beatStart": true,
    "ttsText": "最后交代来源：这套视频的内容，改编自开源课程 <Learn|L ER1 N> <Claude|K L AO1 D> <Code|K OW1 D>。"
  },
  {
    "id": "p5-07",
    "scene": "P5",
    "text": "今天的生产细节，来自原作者的单方核查，没锁版本，计数会漂移。"
  }
]
