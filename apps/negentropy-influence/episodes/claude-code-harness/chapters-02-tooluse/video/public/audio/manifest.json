[
 {
  "id": "p0-01",
  "scene": "P0",
  "text": "这是一双什么都拿得动，却事事要先拼咒语的手。",
  "beatStart": true,
  "blockStart": true,
  "cue": {
   "emo": "melancholic:0.15"
  },
  "durationSec": 4.395
 },
 {
  "id": "p0-02",
  "scene": "P0",
  "text": "家什只有一件：bash。",
  "ttsText": "家什只有一件：<bash|B AE1 SH>。",
  "durationSec": 2.327
 },
 {
  "id": "p0-03",
  "scene": "P0",
  "text": "想读，拼一条读的命令；想写，引号套引号；想改，请出更拗口的命令。",
  "blockStart": true,
  "cue": {
   "emo": "calm:0.10"
  },
  "durationSec": 6.405
 },
 {
  "id": "p0-04",
  "scene": "P0",
  "text": "模型想的是读这个文件，说出口的，却是一串字符。",
  "durationSec": 4.67
 },
 {
  "id": "p0-05",
  "scene": "P0",
  "text": "这层翻译费钱粮，还容易拼错——错一个字符，整条作废。",
  "beatStart": true,
  "blockStart": true,
  "cue": {
   "emo": "melancholic:0.12"
  },
  "ttsText": "这层翻译，费钱粮，还容易拼错——错一个字符，整条作废。",
  "durationSec": 4.76
 },
 {
  "id": "p0-06",
  "scene": "P0",
  "text": "更深一层：bash 万能，却没有形状——在程序眼里，读和写都是一串字符。",
  "durationSec": 6.083
 },
 {
  "id": "p0-07",
  "scene": "P0",
  "text": "今天，给它长出更多的手：一只手一件事，各有名字。",
  "blockStart": true,
  "cue": {
   "emo": "happy:0.15"
  },
  "ttsText": "今天，给它长出更多的手：一只手，一件事，各有名字。",
  "durationSec": 5.648
 },
 {
  "id": "p1-01",
  "scene": "P1",
  "text": "先摆答案：加一个工具，只做两件事。",
  "beatStart": true,
  "blockStart": true,
  "cue": {
   "emo": "calm:0.10"
  },
  "durationSec": 3.17
 },
 {
  "id": "p1-02",
  "scene": "P1",
  "text": "第一件，定义：清单加一条，名字、描述，一份参数说明书。",
  "durationSec": 4.505
 },
 {
  "id": "p1-03",
  "scene": "P1",
  "text": "第二件，注册：往对照表里加一行，名字，对上干活的部件。",
  "ttsText": "第二件，注册：往对照表里加一<行|HANG2>，名字，对上干活的部件。",
  "durationSec": 4.682
 },
 {
  "id": "p1-04",
  "scene": "P1",
  "text": "循环里唯一的变动在执行：写死的跑命令，换成查表，名字对出部件，参数递过去。",
  "beatStart": true,
  "blockStart": true,
  "cue": {
   "emo": "calm:0.08"
  },
  "durationSec": 7.401
 },
 {
  "id": "p1-05",
  "scene": "P1",
  "text": "从一件长到五件：跑命令、读文件、写文件、改文件、找文件。",
  "cue": {
   "emo": "calm:0.08"
  },
  "durationSec": 5.75
 },
 {
  "id": "p1-06",
  "scene": "P1",
  "text": "每加一个工具，两处改动；循环，一行没改。",
  "ttsText": "每加一个工具，两处改动；循环——一<行|HANG2>没改。",
  "durationSec": 3.817
 },
 {
  "id": "p1-07",
  "scene": "P1",
  "text": "值得停一拍：这五件没给模型新本事——同样的活，原来那件也能干。",
  "beatStart": true,
  "blockStart": true,
  "cue": {
   "emo": "surprised:0.12"
  },
  "ttsText": "值得停一拍：这五件，没给模型新本事——同样的活，原来那件也能干。",
  "durationSec": 5.97
 },
 {
  "id": "p1-08",
  "scene": "P1",
  "text": "它们改善的是接口：模型直接说意图；装置第一次看得清——这是读，那是写。",
  "ttsText": "它们改善的，是接口：模型直接说意图；装置第一次看得清——这是读，那是写。",
  "durationSec": 6.62
 },
 {
  "id": "p1-09",
  "scene": "P1",
  "text": "文件类的四件各带一道边界：路径必须落在工作目录内，越界即报错。",
  "beatStart": true,
  "blockStart": true,
  "cue": {
   "emo": "calm:0.10"
  },
  "durationSec": 5.89
 },
 {
  "id": "p1-10",
  "scene": "P1",
  "text": "安全这件事，第一次有了抓手。",
  "durationSec": 2.747
 },
 {
  "id": "p2-01",
  "scene": "P2",
  "text": "走个例子。你说：读一下 a、b 两个文件，列出所有代码文件。",
  "beatStart": true,
  "blockStart": true,
  "cue": {
   "emo": "happy:0.10"
  },
  "durationSec": 4.82
 },
 {
  "id": "p2-02",
  "scene": "P2",
  "text": "交给 bash：三条命令，读要拼路径，列要配模式，错一个字符就废。",
  "durationSec": 5.322
 },
 {
  "id": "p2-03",
  "scene": "P2",
  "text": "专用工具版：一次回答带三个调用——两枚读文件、一枚找文件，参数就位。",
  "blockStart": true,
  "cue": {
   "emo": "calm:0.08"
  },
  "ttsText": "专用工具版：一次回答，带三个调用——两枚读文件、一枚找文件，参数就位。",
  "durationSec": 6.365
 },
 {
  "id": "p2-04",
  "scene": "P2",
  "text": "照表分发，逐个执行，结果原路回喂。",
  "durationSec": 3.271
 },
 {
  "id": "p2-05",
  "scene": "P2",
  "text": "同一件事，两种说法：左边咒语，右边意图——那层翻译，消失了。",
  "blockStart": true,
  "cue": {
   "emo": "happy:0.12"
  },
  "durationSec": 6.4
 },
 {
  "id": "p2-06",
  "scene": "P2",
  "text": "顺带一件新事：一次回答，可以同时带好几个调用。",
  "beatStart": true,
  "durationSec": 3.98
 },
 {
  "id": "p2-07",
  "scene": "P2",
  "text": "那结果怎么各归各？往下看。",
  "durationSec": 2.748
 },
 {
  "id": "p3-01",
  "scene": "P3",
  "text": "秘密在编号上。每个调用，自带一个唯一单号。",
  "beatStart": true,
  "blockStart": true,
  "cue": {
   "emo": "calm:0.10"
  },
  "ttsText": "秘密，在编号上。每个调用，自带一个，唯一单号。",
  "durationSec": 4.42
 },
 {
  "id": "p3-02",
  "scene": "P3",
  "text": "执行侧把结果包成同号回执，喂回去时按单号对回原调用。",
  "durationSec": 5.216
 },
 {
  "id": "p3-03",
  "scene": "P3",
  "text": "像快递并发派送：多个订单，包裹各贴单号——谁先到都对得回。",
  "blockStart": true,
  "cue": {
   "emo": "happy:0.10"
  },
  "durationSec": 5.12
 },
 {
  "id": "p3-04",
  "scene": "P3",
  "text": "边界：快递单号跨天有效、可查物流；这个单号只活一轮，回执也只此一份。",
  "durationSec": 6.037
 },
 {
  "id": "p3-05",
  "scene": "P3",
  "text": "教学版按顺序执行——配对的价值，要到乱序与并发才显形。",
  "beatStart": true,
  "blockStart": true,
  "cue": {
   "emo": "calm:0.10"
  },
  "durationSec": 6.124
 },
 {
  "id": "p3-06",
  "scene": "P3",
  "text": "实测说话：先让结果乱序到达，再拔掉编号——同轮结果当场错绑。",
  "blockStart": true,
  "cue": {
   "emo": "afraid:0.14"
  },
  "durationSec": 5.88
 },
 {
  "id": "p3-07",
  "scene": "P3",
  "text": "十轮照跑完十轮，七件活照做——外面看不出异样。",
  "beatStart": true,
  "blockStart": true,
  "cue": {
   "emo": "afraid:0.12"
  },
  "durationSec": 4.0
 },
 {
  "id": "p3-08",
  "scene": "P3",
  "text": "错处在里面：有一轮两个调用，结果互换——模型拿到别人的答案。",
  "durationSec": 4.997
 },
 {
  "id": "p3-09",
  "scene": "P3",
  "text": "教训一句话：没有配对，乱序即错位。",
  "blockStart": true,
  "cue": {
   "emo": "surprised:0.14"
  },
  "ttsText": "教训一句话：没有配对，乱序，即错位。",
  "durationSec": 3.84
 },
 {
  "id": "p3-10",
  "scene": "P3",
  "text": "顺序好的时候它白拿工资；一乱，就翻车。",
  "ttsText": "顺序好的时候，它白拿工资；一乱，就翻车。",
  "durationSec": 4.35
 },
 {
  "id": "p4-01",
  "scene": "P4",
  "text": "那真实的 Claude Code 呢？",
  "beatStart": true,
  "blockStart": true,
  "cue": {
   "emo": "surprised:0.12"
  },
  "durationSec": 1.76
 },
 {
  "id": "p4-02",
  "scene": "P4",
  "text": "拆解过 Claude Code 源码的同学们应该知道：每个工具调用，要过五道关才落地。",
  "ttsText": "拆解过 Claude Code 源码的同学们应该知道：每个工具调用，要过五道关，才落地。",
  "durationSec": 6.204
 },
 {
  "id": "p4-03",
  "scene": "P4",
  "text": "参数查两道：格式、取值；再一道先行检查、一道放行权，第五道才是执行。",
  "blockStart": true,
  "cue": {
   "emo": "calm:0.12"
  },
  "durationSec": 7.401
 },
 {
  "id": "p4-04",
  "scene": "P4",
  "text": "谁能一起跑，不按「只读都能跑」粗判——按具体输入判：列目录能，删除不能。",
  "beatStart": true,
  "blockStart": true,
  "cue": {
   "emo": "calm:0.08"
  },
  "durationSec": 6.12
 },
 {
  "id": "p4-05",
  "scene": "P4",
  "text": "还有改了状态也能并发的：比如建任务，每次写不同的文件。",
  "durationSec": 4.2
 },
 {
  "id": "p4-06",
  "scene": "P4",
  "text": "一串调用按连续批分区：批内并发，批间保序。",
  "durationSec": 3.668
 },
 {
  "id": "p4-07",
  "scene": "P4",
  "text": "结果太长就存成文件，模型看预览加路径。",
  "beatStart": true,
  "blockStart": true,
  "cue": {
   "emo": "happy:0.10"
  },
  "durationSec": 3.62
 },
 {
  "id": "p4-08",
  "scene": "P4",
  "text": "唯独读文件，上限无穷大——不然读的结果存成新文件，新文件又被再读、再存，无限循环。",
  "durationSec": 6.75
 },
 {
  "id": "p4-09",
  "scene": "P4",
  "text": "例外，也有例外的道理。",
  "durationSec": 1.671
 },
 {
  "id": "p5-01",
  "scene": "P5",
  "text": "一句话收束：核心不变，能力正交叠加——各管各的，互不牵连。",
  "beatStart": true,
  "blockStart": true,
  "cue": {
   "emo": "calm:0.15"
  },
  "ttsText": "一句话收束：核心不变，能力，正交叠加——各管各的，互不牵连。",
  "durationSec": 5.94
 },
 {
  "id": "p5-02",
  "scene": "P5",
  "text": "五件家什换进来，循环一行没改；往后每个新能力，都往循环的固定挂点上加。",
  "ttsText": "五件家什换进来，循环一<行|HANG2>没改；往后每个新能力，都往循环的固定挂点上加。",
  "durationSec": 6.215
 },
 {
  "id": "p5-03",
  "scene": "P5",
  "text": "这双手，五根手指也长齐了。",
  "blockStart": true,
  "cue": {
   "emo": "happy:0.12"
  },
  "durationSec": 3.245
 },
 {
  "id": "p5-04",
  "scene": "P5",
  "text": "只是别忘了：文件工具有边界，bash 还全开着——删盘命令照样跑得到。",
  "blockStart": true,
  "cue": {
   "emo": "melancholic:0.12"
  },
  "durationSec": 5.98
 },
 {
  "id": "p5-05",
  "scene": "P5",
  "text": "在动手之前，加一道门——下期。",
  "durationSec": 2.616
 },
 {
  "id": "p5-06",
  "scene": "P5",
  "text": "最后交代来源：这套视频的内容，改编自开源课程 Learn Claude Code。",
  "beatStart": true,
  "ttsText": "最后交代来源：这套视频的内容，改编自开源课程 <Learn|L ER1 N> <Claude|K L AO1 D> <Code|K OW1 D>。",
  "blockStart": true,
  "cue": {
   "emo": "calm:0.10"
  },
  "durationSec": 6.171
 },
 {
  "id": "p5-07",
  "scene": "P5",
  "text": "今天的生产细节，来自原作者的单方核查，没锁版本，计数会漂移。",
  "cue": {
   "emo": "calm:0.10"
  },
  "durationSec": 6.043
 }
]
