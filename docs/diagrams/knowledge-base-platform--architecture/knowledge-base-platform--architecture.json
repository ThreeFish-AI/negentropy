  "cards": [
    {
      "dot": "rose",
      "title": "安全不变量",
      "items": [
        "权限谓词先合取再下推四路召回（非先召回后过滤），fail-closed",
        "Chunk 物化继承版本 ACL，不放大不缩小；读写双审计",
        "检索访问与编辑操作双审计，仅追加不可篡改"
      ]
    },
    {
      "dot": "cyan",
      "title": "检索与索引",
      "items": [
        "四路索引（BM25/元数据/向量/地理）混合召回，RRF 融合；向量路含图文跨模态（独立模型空间）",
        "索引蓝绿版本：构建→校验→切换→下线，全程可回滚"
      ]
    },
    {
      "dot": "emerald",
      "title": "闭环与重建",
      "items": [
        "canonical 版本库为 SSOT，任何索引可全量重放重建",
        "线上反馈归因回流：评测集扩充、排序调参、知识补录",
        "评测回归门控索引重建与检索策略变更"
      ]
    }
  ]
