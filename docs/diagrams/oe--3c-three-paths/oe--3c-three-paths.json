  "cards": [
    {
      "dot": "cyan",
      "title": "三桥递进",
      "items": [
        "变换→对齐→融合：输入在模型内交互得越早、分辨率越细，能力越偏向组合性",
        "把融合的交互强度调到零，就退回双塔对齐——对齐是融合的特例"
      ]
    },
    {
      "dot": "emerald",
      "title": "3C 分立举证",
      "items": [
        "覆盖/可比/组合须分别举证：徽章计数、共享骨干、共用损失都不是任何一级的证据",
        "C3 判据 Δcomp：融合向量须同时胜过最强单输入、分数加权合并、向量加权相加"
      ]
    },
    {
      "dot": "rose",
      "title": "已证现状（截至综述统计）",
      "items": [
        "被检的广输入系统大多停在 C1/C2，组合性证据几乎全空或仅部分达标",
        "唯一强组合性证据只覆盖两个模态；统一基准建成前，终局论是假说"
      ]
    }
  ]
