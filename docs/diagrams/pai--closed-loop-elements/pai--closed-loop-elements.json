    {
      "dot": "rose",
      "title": "环经物理世界闭合",
      "items": [
        "命令发出去不等于事情做成",
        "只有传感器读回的物理结果才算数",
        "夹爪闭合 ≠ 抓到；消息送达 ≠ 执行"
      ]
    },
    {
      "dot": "emerald",
      "title": "判据（定义四推论）",
      "items": [
        "观测接到世界真实量（物理接地）",
        "存在干预路径与反馈修正行为",
