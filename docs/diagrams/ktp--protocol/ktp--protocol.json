      "width": 186
    },
    {
      "id": "test_t2i",
      "lane": "test",
      "col": 2,
      "type": "backend",
      "label": "文生图训练",
      "sublabel": "没有任何问答",
      "width": 146
    },
    {
      "id": "text_probe",
      "lane": "test",
      "col": 4,
      "type": "frontend",
      "label": "文字问答",
      "sublabel": "无图 · 整串一致",
      "width": 156
    },
    {
      "id": "redraw",
      "lane": "eval",
      "col": 4,
      "type": "frontend",
      "label": "重画",
      "sublabel": "判官 + 编辑距离容差",
      "width": 176
    },
    {
      "id": "metrics",
      "lane": "eval",
      "col": 5,
      "type": "security",
      "label": "指标",
      "sublabel": "A_text · A_vis · Δ",
      "width": 156
    }
  ],
  "edges": [
    {
      "id": "e_build",
      "from": "triples",
      "to": "images",
      "label": "生图 + 质检"
    },
    {
      "id": "e_to_test",
      "from": "images",
      "to": "test_t2i",
      "variant": "emphasis"
    },
    {
      "id": "e_to_align",
      "from": "images",
      "to": "align_t2i",
      "role": "branch"
    },
    {
      "id": "e_align",
      "from": "align_t2i",
      "to": "align_extra"
    },
    {
      "id": "e_text",
      "from": "test_t2i",
      "to": "text_probe",
      "label": "纯文字提问",
      "variant": "emphasis"
    },
    {
      "id": "e_redraw",
      "from": "test_t2i",
      "to": "redraw",
      "role": "branch"
    },
    {
      "id": "e_m1",
      "from": "text_probe",
      "to": "metrics",
      "variant": "emphasis"
    },
    {
      "id": "e_m2",
      "from": "redraw",
      "to": "metrics"
    },
    {
      "id": "e_transfer",
      "from": "align_extra",
      "to": "text_probe",
      "label": "跨实体迁移？",
      "variant": "dashed",
      "role": "async"
    }
  ],
  "cards": [
    {
      "dot": "cyan",
      "title": "信息隔离",
      "items": [
        "实体全部虚构，模型以前不可能见过",
        "画图指令经语言模型审查，不提也不暗示取值",
        "直接迁移条件另混 1 万条无关问答，只教答题格式"
      ]
    },
    {
      "dot": "violet",
      "title": "两把尺子",
      "items": [
        "文字：删思考块后与标准答案整串一致",
        "画图：判官看图，书名等文字按长度容差 1/2/3",
        "Δ_access = A_vis − A_text"
      ]
    },
    {
      "dot": "amber",
      "title": "只在测试集算分",
      "items": [
        "测试实体的取值只出现在训练图里",
        "对齐实体自己的成绩只作对照（号码 72%）"
      ]
    }
  ]
}
