          "label": "知识来源"
        },
        "database": {
          "label": "训练数据"
        },
        "backend": {
          "label": "训练"
        },
        "messagebus": {
          "label": "对齐监督"
        },
        "frontend": {
          "label": "探针"
        },
        "security": {
          "label": "指标"
        }
      }
    }
  },
  "lanes": [
    {
      "id": "build",
      "label": "数据构造"
    },
    {
      "id": "align",
      "label": "对齐集 · 每类 25"
    },
    {
      "id": "test",
      "label": "测试集 · 每类 25"
    },
    {
      "id": "eval",
      "label": "评测"
    }
  ],
  "phases": [
    {
      "id": "p_data",
      "label": "造数据",
      "fromCol": 0,
      "toCol": 1
    },
    {
      "id": "p_train",
      "label": "同一次训练",
      "fromCol": 2,
      "toCol": 3,
      "variant": "emphasis"
    },
    {
      "id": "p_eval",
      "label": "只在测试集算分",
      "fromCol": 4,
      "toCol": 5,
      "variant": "dashed"
    }
  ],
  "mainPath": [
    "triples",
    "images",
    "test_t2i",
    "text_probe",
    "metrics"
  ],
  "nodes": [
    {
      "id": "triples",
      "lane": "build",
      "col": 0,
      "type": "external",
      "label": "虚构三元组",
      "sublabel": "7 类 × 50 个实体",
      "width": 150
    },
    {
      "id": "images",
      "lane": "build",
      "col": 1,
      "type": "database",
      "label": "训练图",
      "sublabel": "每单元约 25 张 · 8,552",
      "width": 172
    },
    {
      "id": "align_t2i",
      "lane": "align",
      "col": 2,
      "type": "backend",
      "label": "文生图训练",
      "sublabel": "指令不提取值",
      "width": 146
    },
    {
      "id": "align_extra",
      "lane": "align",
      "col": 3,
      "type": "messagebus",
      "label": "+ 对齐样本",
