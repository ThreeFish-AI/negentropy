  "cards": [
    {
      "dot": "cyan",
      "title": "两级过滤",
      "items": [
        "程序管人：名单/@/准入表定强度，正文引用骗不了代码闸",
        "模型管事：三事实+逐条启用规则判定，observe 档只记 would-accept"
      ]
    },
    {
      "dot": "rose",
      "title": "上下文 ≠ 权限",
      "items": [
        "订阅线程的任何消息（含 bot/CI）直达工单当背景，一条都不构成新授权",
        "只有真人消息能复活已结束工单，复活前按当日规则重验票据"
      ]
    },
    {
      "dot": "emerald",
      "title": "约束的五级阶梯",
      "items": [
        "宿主强制 > 内建提示 > 匹配规则 > 团队段落 > 外部文本（纯数据）",
        "提示词层只管纪律与风格；先记账后干活由代码保证"
      ]
    }
  ]
