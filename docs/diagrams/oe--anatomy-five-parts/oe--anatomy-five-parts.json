  "cards": [
    {
      "dot": "cyan",
      "title": "结构五件套",
      "items": [
        "数据单元→tokenizer→编码器→聚合→表征对象是五条正交轴，可单独替换",
        "同一骨架在每个模态重复出现，变的只是每格的实现"
      ]
    },
    {
      "dot": "emerald",
      "title": "建模决策位",
      "items": [
        "训练目标与评测是决策位而非结构件：换目标不换骨干、换评测不换模型",
        "预训练（海量弱信号）在前，微调（任务信号）在后，是全模态共同配方"
      ]
    },
    {
      "dot": "rose",
      "title": "两个关键断言",
      "items": [
        "模态差异住在 tokenizer 里，共性住在骨干里（骨干对输入是不做预设的集合算子）",
        "表征对象而非编码器决定嵌入能干什么：更强的编码器≠更好的嵌入"
      ]
    }
  ]
}
