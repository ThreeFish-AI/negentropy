  "cards": [
    {
      "dot": "emerald",
      "title": "指针而非副本",
      "items": [
        "Context Catalog 是 PostgreSQL VIEW，子系统数据原地不动（013 ADR-1）",
        "Collect 只持五个子系统的指针，Activate 经 Catalog 定位后再取用",
        "五个子系统全部落在 PostgreSQL（含 Tools、Skills，builtin_tools 与 skills 均为 PG 表）"
      ]
    },
    {
      "dot": "amber",
      "title": "相对旧版 Mermaid 的校准",
      "items": [
        "补全 Tools、Skills → PostgreSQL 两条持久化边（旧图只画 Memory / KB / KG）",
        "Router 命名：013 ADR-2 不新建 Router 类，路由并入升级后的 HybridPlanner",
        "三段是 Horizon 叙事；013 §9 把时间面细化为六段两环"
      ]
    },
    {
      "dot": "rose",
      "title": "目标态口径（如实标注）",
      "items": [
        "ContextGuard 目录不存在，Activate 的出口守卫是方案位（013 §12.4）",
        "信任归一与语义富化的归一信任分处于设计态（013 §7.2）"
      ]
    }
  ]
