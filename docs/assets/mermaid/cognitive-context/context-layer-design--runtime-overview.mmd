graph TB
    subgraph RUNTIME["Agent Runtime"]
        runtime["SubAgents + Workflow / Pipelines + Toolset"]
    end
    subgraph CONTEXT["Context Layer（上下文治理层）"]
        direction LR
        collect["① Collect<br/>Context Catalog · PG VIEW"]
