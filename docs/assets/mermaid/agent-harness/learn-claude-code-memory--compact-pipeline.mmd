        IN --> B --> SNIP
    end
    subgraph C["02 模型调用"]
        CALL["模型调用<br/>API 请求"]
    end
    subgraph E["EX 工具与应急"]
        TOOLS["工具批次执行<br/>整批完成才进下一轮"]
