%% derived: 渐进披露系列（2026-10-10）：执行前展开三道闸门链（硬拒绝 → 规则匹配 → 用户审批；拒绝结果回喂）
%% note: PreToolUse 钩子为 §6 内容，本图未含——§6 终态图中闸门链将降格为挂在 PreToolUse 下的回调
flowchart TD
    subgraph LOOP["循环本体 · s01 Agent Loop"]
        direction TB
        P["用户输入"] --> UPS["UserPromptSubmit 钩子"]
        UPS --> LLM["调用模型（附工具定义）"]
        LLM --> CRIT{"回答里出现工具调用块？"}
    end

    subgraph SAFE["裁决与执行 · s03 Permission"]
        direction TB
        G1{"闸门 1：硬拒绝表"}
        G1 -- "命中" --> DENY["拒绝结果回喂模型"]
        G1 -- "未命中" --> G2{"闸门 2：规则匹配"}
        G2 -- "未命中" --> RUN["TOOL_HANDLERS 查表执行"]
        G2 -- "命中" --> G3{"闸门 3：用户审批"}
        G3 -- "拒绝" --> DENY
        G3 -- "允许" --> RUN
        RUN --> TR["tool_result 按 tool_use_id 配对回喂"]
        DENY --> TR
    end

    CRIT -- "有" --> G1
    TR --> LLM
    CRIT -- "没有" --> STOP["Stop 钩子"]
    STOP -- "注入 user 消息续跑" --> LLM
    STOP -- "返回空" --> DONE["循环退出"]

    HOOKS["Hooks：扩展挂点（§6）"]
    LOOP -. "§6 展开" .-> HOOKS

    classDef loopnode fill:#1f6feb,stroke:#79c0ff,color:#ffffff
    classDef safenode fill:#238636,stroke:#7ee787,color:#ffffff
    classDef gatenode fill:#9e6a03,stroke:#e3b341,color:#ffffff
    classDef endnode fill:#6e7681,stroke:#c9d1d9,color:#ffffff
    classDef placeholder fill:#30363d,stroke:#8b949e,color:#e6edf3,stroke-dasharray: 5 5
    class P,UPS,LLM,CRIT,RUN,TR loopnode
    class G1,G2,G3,DENY gatenode
    class STOP,DONE endnode
    class HOOKS placeholder
