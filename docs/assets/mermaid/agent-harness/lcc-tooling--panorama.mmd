flowchart LR
    subgraph LOOP["主循环 · s01 Agent Loop"]
        direction LR
        P["用户输入"] --> UPS["UserPromptSubmit 钩子<br/>§6 钩子"]
        UPS --> LLM["调用模型<br/>附全部工具定义"]
        LLM --> CRIT{"有工具调用块？<br/>needsFollowUp·认内容块"}
        CRIT -- "没有" --> STOP["Stop 钩子<br/>stopHookActive 防死循环"]
        STOP -- "返回空" --> DONE["循环退出"]
    end

    subgraph SAFE["裁决与执行 · s03 Permission + s04 Hooks"]
        direction LR
        PRE["PreToolUse 钩子<br/>不变式：allow 压不过 deny"] --> G["三道闸门<br/>硬拒绝→规则→审批<br/>auto 分类器替换闸门 3"]
        G -- "放行" --> RUN["查表执行<br/>TOOL_HANDLERS<br/>partitionToolCalls"]
        RUN --> POST["PostToolUse 钩子"]
        POST --> TR["tool_result 配对<br/>拒绝结果同样回喂"]
    end

    CRIT -- "有" --> PRE
    TR -- "回喂·接着想下一步" --> LLM

