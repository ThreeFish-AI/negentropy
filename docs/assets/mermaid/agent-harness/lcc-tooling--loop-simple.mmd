        FEED --> THINK
        Q -- "不用了" --> DONE["交出最终结果"]
    end

    TOOLS["Tool Use：更多专用工具（§4）"]
    PERM["Permission：动手前的闸门（§5）"]
    HOOKS["Hooks：扩展挂点（§6）"]

    THINK -. "§4 展开" .-> TOOLS
    ACT -. "§5 展开" .-> PERM
    LOOP -. "§6 展开" .-> HOOKS

    classDef loopnode fill:#1f6feb,stroke:#79c0ff,color:#ffffff
