flowchart TD
    U["用户请求开始"] --> IDX["MEMORY.md 索引常驻<br/>system prompt 固定前缀<br/>命中 prompt cache · 便宜"]
    U --> SEL["旁路选择（轻量 1 次调用）<br/>最近对话 + name/description 目录<br/>选 ≤5 条 · 失败降级关键词"]
    IDX --> SYS["system prompt<br/>（每次调用开头不变区）"]
    SEL --> LOAD["读取选中文件正文<br/>总量 ≤20K 字符"]
    LOAD --> TURN["注入当前 user turn<br/>（不破坏固定前缀）<br/>召回内容=背景知识 · 冲突时当前请求优先"]
    SYS --> LLM["模型调用"]
    TURN --> LLM
    LLM --> TOOLS["工具执行"]
    TOOLS --> LLM
    LLM -- "停止且无工具调用（会话告一段落）" --> EXT["提取：三道门<br/>① scope=persistent<br/>② 临时词黑名单 20 词<br/>③ 三重查重"]
    EXT -- "全过" --> WRITE["写 .memory/*.md + frontmatter<br/>重建索引"]
    WRITE --> GATE{"文件数 ≥ 10？"}
    GATE -- 是 --> CONS["整理（事务性）<br/>快照 → 合并去重 ≤30 条<br/>失败恢复原样"]
    CONS --> IDX
    WRITE --> IDX
