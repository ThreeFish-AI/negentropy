flowchart TD
    subgraph LOOP["循环本体 · s01 Agent Loop"]
        direction TB
        P["用户输入"] --> UPS["UserPromptSubmit 钩子"]
        UPS --> LLM["调用模型（附工具定义）"]
        LLM --> CRIT{"回答里出现工具调用块？"}
        CRIT -- "有" --> EXEC["程序执行工具（§4 展开）"]
        EXEC --> TR["tool_result 按 tool_use_id 配对回喂"]
        TR --> LLM
        CRIT -- "没有" --> STOP["Stop 钩子"]
        STOP -- "注入 user 消息续跑" --> LLM
        STOP -- "返回空" --> DONE["循环退出"]
    end

    TOOLS["Tool Use（§4）"]
    PERM["Permission（§5）"]
    HOOKS["Hooks（§6）"]

    EXEC -. "§4" .-> TOOLS
    EXEC -. "§5" .-> PERM
    LOOP -. "§6" .-> HOOKS

    classDef loopnode fill:#1f6feb,stroke:#79c0ff,color:#ffffff
