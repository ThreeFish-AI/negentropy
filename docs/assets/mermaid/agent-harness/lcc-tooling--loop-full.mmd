flowchart LR
    ASK["用户输入<br/>首条 user 消息"] --> UPS["UserPromptSubmit<br/>输入后·进模型前<br/>注入上下文"]
    UPS --> THINK["调用模型<br/>附全量工具定义<br/>只决策·不执行"]
    THINK -- "有工具调用块" --> ACT["程序执行工具<br/>§4 展开为查表分发<br/>§4"]
    ACT -- "执行结果" --> FEED["tool_result 回喂<br/>按 tool_use_id 配对·以 user 消息追加"]
    FEED -- "回喂·接着想下一步" --> THINK
    THINK -. "没有工具调用块" .-> STOP["Stop<br/>返回空才真退出·非 None 注入续跑<br/>非 None 可续跑"]
    STOP -. "返回空" .-> DONE["循环退出<br/>交出最终结果"]
    ACT -. "§4" .-> TOOLS["Tool Use<br/>查表分发<br/>§4"]
